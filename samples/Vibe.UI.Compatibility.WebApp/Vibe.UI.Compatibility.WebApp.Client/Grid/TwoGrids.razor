@* Two grids in one component. The framework tells a component's saved state apart by its
   parent, its type and its key, so two grids of one row type under one parent are the same to
   it unless each has a key. Keyed, each starts with its own prerendered page. Unkeyed, neither
   is given one and each fetches again, with its own rows: slower, never wrong. *@
@using Microsoft.AspNetCore.Components.QuickGrid

<section data-testid="two-grids">
    @if (Keyed)
    {
        <div data-testid="first">
            <VibeGrid @key="@("alpha")" TGridItem="Row" ItemsProvider="ProvideAlpha" PageSize="5">
                <PropertyColumn Property="row => row.Name" />
            </VibeGrid>
        </div>
        <div data-testid="second">
            <VibeGrid @key="@("beta")" TGridItem="Row" ItemsProvider="ProvideBeta" PageSize="5">
                <PropertyColumn Property="row => row.Name" />
            </VibeGrid>
        </div>
    }
    else
    {
        <div data-testid="first">
            <VibeGrid TGridItem="Row" ItemsProvider="ProvideAlpha" PageSize="5">
                <PropertyColumn Property="row => row.Name" />
            </VibeGrid>
        </div>
        <div data-testid="second">
            <VibeGrid TGridItem="Row" ItemsProvider="ProvideBeta" PageSize="5">
                <PropertyColumn Property="row => row.Name" />
            </VibeGrid>
        </div>
    }

    <p data-testid="two-grids-requests">Alpha: @alpha, Beta: @beta</p>
    <button type="button" data-testid="two-grids-poke" @onclick="() => pokes++">Poked @pokes</button>
</section>

@code {
    public sealed record Row(int Id, string Name);

    private int alpha;
    private int beta;
    private int pokes;

    [Parameter]
    public bool Keyed { get; set; }

    private ValueTask<VibeGridPage<Row>> ProvideAlpha(VibeGridRequest request)
    {
        alpha++;
        _ = InvokeAsync(StateHasChanged);
        return Page("Alpha", request);
    }

    private ValueTask<VibeGridPage<Row>> ProvideBeta(VibeGridRequest request)
    {
        beta++;
        _ = InvokeAsync(StateHasChanged);
        return Page("Beta", request);
    }

    private static ValueTask<VibeGridPage<Row>> Page(string prefix, VibeGridRequest request) =>
        ValueTask.FromResult(new VibeGridPage<Row>(
            Enumerable
                .Range(request.Page * request.PageSize + 1, request.PageSize)
                .Select(i => new Row(i, $"{prefix} {i}"))
                .ToList(),
            40));
}
