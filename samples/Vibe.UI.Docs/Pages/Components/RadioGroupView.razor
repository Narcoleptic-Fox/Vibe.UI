@code {
    private enum Plan { Free, Pro, Enterprise }
    private enum Shipping { Standard, Express, NextDay }
    private enum Billing { Monthly, Yearly }
    private enum Contact { Email, Phone, TextMessage }

    // Interactive preview state
    private Plan plan = Plan.Pro;
    private RadioGroupOrientation currentOrientation = RadioGroupOrientation.Vertical;
    private bool currentDisabled = false;

    // Example values
    private Shipping shipping = Shipping.Standard;
    private Billing billing = Billing.Yearly;
    private Contact? contact;

    // PropTweaker props
    private List<PropDefinition> radioProps = new();

    protected override void OnInitialized()
    {
        InitializeProps();
    }

    private void InitializeProps()
    {
        radioProps = new List<PropDefinition>
        {
            PropDefinition.Enum<Plan>("Value", Plan.Pro, "Currently selected plan"),
            PropDefinition.Enum<RadioGroupOrientation>("Orientation", RadioGroupOrientation.Vertical, "Layout orientation"),
            PropDefinition.Boolean("Disabled", false, "Disable the radio group")
        };
    }

    private void HandlePropChanged(PropDefinition prop)
    {
        switch (prop.Name)
        {
            case "Value":
                if (Enum.TryParse<Plan>(prop.Value?.ToString(), out var chosen))
                    plan = chosen;
                break;
            case "Orientation":
                if (Enum.TryParse<RadioGroupOrientation>(prop.Value?.ToString(), out var orientation))
                    currentOrientation = orientation;
                break;
            case "Disabled":
                currentDisabled = prop.Value is true || prop.Value?.ToString()?.ToLower() == "true";
                break;
        }
        StateHasChanged();
    }

    private void HandlePropsReset()
    {
        plan = Plan.Pro;
        currentOrientation = RadioGroupOrientation.Vertical;
        currentDisabled = false;
        InitializeProps();
        StateHasChanged();
    }

    private string GeneratedCode
    {
        get
        {
            var props = new List<string> { "@bind-Value=\"plan\"", "AriaLabel=\"Plan\"" };
            if (currentOrientation != RadioGroupOrientation.Vertical)
                props.Add($"Orientation=\"RadioGroupOrientation.{currentOrientation}\"");
            if (currentDisabled)
                props.Add("Disabled=\"true\"");

            return $$"""
                <RadioGroup {{string.Join(" ", props)}} />

                @code {
                    private enum Plan { Free, Pro, Enterprise }

                    private Plan plan = Plan.{{plan}};
                }
                """;
        }
    }

    private const string EnumCode = """
        <RadioGroup @bind-Value="shipping" AriaLabel="Shipping" />

        @code {
            private enum Shipping { Standard, Express, NextDay }

            private Shipping shipping = Shipping.Standard;   // options: Standard, Express, Next day
        }
        """;

    private const string LabelsCode = """
        <RadioGroup @bind-Value="shipping" AriaLabel="Shipping speed">
            <RadioGroupItem Value="Shipping.Standard">Standard, 5 to 7 days</RadioGroupItem>
            <RadioGroupItem Value="Shipping.Express">Express, 2 days</RadioGroupItem>
            <RadioGroupItem Value="Shipping.NextDay">Next day</RadioGroupItem>
        </RadioGroup>
        """;

    private const string HorizontalCode = """
        <RadioGroup @bind-Value="billing" AriaLabel="Billing"
                    Orientation="RadioGroupOrientation.Horizontal" />

        @code {
            private enum Billing { Monthly, Yearly }

            private Billing billing = Billing.Yearly;
        }
        """;

    private const string DisabledCode = """
