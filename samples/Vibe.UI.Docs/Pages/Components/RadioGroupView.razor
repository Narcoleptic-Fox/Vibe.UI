@page "/components/radiogroup"
@using Vibe.UI.Docs.Models

<PageTitle>RadioGroup - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">RadioGroup</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">RadioGroup</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A set of checkable buttons where only one can be selected at a time.
        </p>
    </header>

    <!-- Interactive Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Interactive Preview</h2>
        <LivePreview Code="@GeneratedCode" Props="@radioProps" OnPropChanged="HandlePropChanged" OnPropsReset="HandlePropsReset">
            <PreviewContent>
                <div class="vibe-max-w-md">
                    <RadioGroup @bind-Value="plan"
                                AriaLabel="Plan"
                                Orientation="@currentOrientation"
                                Disabled="@currentDisabled" />
                    <p class="vibe-mt-3 vibe-text-sm vibe-text-muted-foreground">Selected: @($"Plan.{plan}")</p>
                </div>
            </PreviewContent>
        </LivePreview>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <!-- Enum, no items written -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Bound to an enum</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Bind an enum and write no items: the group lists one option per value, labelled from
                the value's name, so <code>NextDay</code> shows as "Next day". The bound value is the
                enum itself, not a string.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md" data-testid="radio-enum-shipping">
                    <RadioGroup @bind-Value="shipping" AriaLabel="Shipping" />
                    <p class="vibe-mt-3 vibe-text-sm vibe-text-muted-foreground" id="radio-enum-shipping-value">Value: @($"Shipping.{shipping}")</p>
                </div>
            </div>
            <CodeBlock Code="@EnumCode" Language="razor" />
        </div>

        <!-- Written items -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Your own labels</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Write the items to choose the labels and the order, or to leave values out. Each
                item's value is the enum value itself.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <RadioGroup @bind-Value="shipping" AriaLabel="Shipping speed">
                        <RadioGroupItem Value="Shipping.Standard">Standard, 5 to 7 days</RadioGroupItem>
                        <RadioGroupItem Value="Shipping.Express">Express, 2 days</RadioGroupItem>
                        <RadioGroupItem Value="Shipping.NextDay">Next day</RadioGroupItem>
                    </RadioGroup>
                </div>
            </div>
            <CodeBlock Code="@LabelsCode" Language="razor" />
        </div>

        <!-- Horizontal Layout -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Horizontal layout</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Lay a short set of options out in a row.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <RadioGroup @bind-Value="billing" AriaLabel="Billing" Orientation="RadioGroupOrientation.Horizontal" />
                </div>
            </div>
            <CodeBlock Code="@HorizontalCode" Language="razor" />
        </div>

        <!-- With Disabled Options -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Disabled options</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Disable one option while keeping the others available. This needs the items written out.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <RadioGroup @bind-Value="plan" AriaLabel="Plan with an unavailable option">
                        <RadioGroupItem Value="Plan.Free">Free</RadioGroupItem>
                        <RadioGroupItem Value="Plan.Pro">Pro</RadioGroupItem>
                        <RadioGroupItem Value="Plan.Enterprise" Disabled="true">Enterprise (contact sales)</RadioGroupItem>
                    </RadioGroup>
                </div>
            </div>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

        <!-- Disabled Group -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Disabled group</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Disable the whole group to show a value that cannot be changed here.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <RadioGroup Disabled="true" Value="Plan.Pro" AriaLabel="Current plan" />
                </div>
            </div>
            <CodeBlock Code="@DisabledGroupCode" Language="razor" />
        </div>

        <!-- Nullable -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Nothing chosen yet</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Bind a nullable enum to start with no option checked. The value stays
                <code>null</code> until the user picks one.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
