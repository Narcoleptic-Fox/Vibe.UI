@page "/components/checkbox"

<PageTitle>Checkbox - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Checkbox</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Checkbox</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A control that allows the user to toggle between checked and not checked states.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-6 vibe-rounded-xl vibe-border vibe-border-border vibe-bg-card vibe-space-y-4">
            <Checkbox>Default checkbox</Checkbox>
            <Checkbox Checked="true">Checked checkbox</Checkbox>
            <Checkbox Indeterminate="true">Partially selected</Checkbox>
            <Checkbox>Accept terms and conditions</Checkbox>
            <Checkbox Checked="@isSubscribed" CheckedChanged="@OnSubscribeChanged">Subscribe to newsletter</Checkbox>
            @if (isSubscribed)
            {
                <div class="vibe-ml-6">
                    <Badge Variant="success"><Vibe.UI.Components.Icon Name="check" />Subscribed</Badge>
                </div>
            }
            <Checkbox Disabled="true">Disabled unchecked</Checkbox>
            <Checkbox Checked="true" Disabled="true">Disabled checked</Checkbox>
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <!-- Basic Usage -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Basic Usage</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Simple checkbox with checked and unchecked states.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Checkbox Label="Receive product updates" />
                <Checkbox Label="Include release notes" Checked="true" />
            </div>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <!-- With Label -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">With Label</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Add a label to provide context for the checkbox selection.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Checkbox Label="Accept terms and conditions" />
                <Checkbox Label="Subscribe to newsletter" Checked="true" />
            </div>
            <CodeBlock Code="@LabelCode" Language="razor" />
        </div>

        <!-- Disabled State -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Disabled State</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Prevent user interaction with the disabled state.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Checkbox Label="Disabled unchecked" Disabled="true" />
                <Checkbox Label="Disabled checked" Checked="true" Disabled="true" />
            </div>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

        <!-- Indeterminate State -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Indeterminate State</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Use indeterminate state to represent partial selection, commonly used for "select all" scenarios.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Checkbox Label="Select all" Indeterminate="true" />
                <Checkbox Label="Some items selected" Indeterminate="true" />
            </div>
            <CodeBlock Code="@IndeterminateCode" Language="razor" />
        </div>

        <!-- With Change Handler -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">With Change Handler</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Handle checkbox state changes with event callbacks.
            </p>
            <CodeBlock Code="@ChangeHandlerCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Checked</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the checkbox is checked</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Indeterminate</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the checkbox is in indeterminate state</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Disabled</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the checkbox is disabled</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Label</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Label text for the checkbox</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Value</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">The value attribute of the checkbox</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">The name attribute of the checkbox</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">AriaLabel</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Accessible name when no visible label is rendered</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">AriaInvalid</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Applies invalid semantics and destructive styling</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ChildContent</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="RenderFragment" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">—</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Custom content for the checkbox label</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">CheckedChanged</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<bool>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Callback when checked state changes</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnChange</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<ChangeEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Native change event callback</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <p class="vibe-text-muted-foreground vibe-mb-4">
            Install the Checkbox component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add checkbox" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Uses semantic <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">&lt;input type="checkbox"&gt;</code> element
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Proper ARIA attributes for indeterminate state
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Label associated with input for clickable area
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Keyboard accessible (Space to toggle)
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                Focus visible styles for keyboard navigation
            </li>
        </ul>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/radiogroup" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Radio Group</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Single selection from multiple options</p>
            </a>
            <a href="components/switch" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Switch</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Toggle on/off states</p>
            </a>
            <a href="components/form" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Form</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Form validation and submission</p>
            </a>
        </div>
    </section>
</div>

@code {
    private bool isSubscribed = false;

    private void OnSubscribeChanged(bool value)
    {
        isSubscribed = value;
    }

    private string BasicCode => @"<Checkbox Label=""Receive product updates"" />
<Checkbox Label=""Include release notes"" Checked=""true"" />";

    private string LabelCode => @"<Checkbox Label=""Accept terms and conditions"" />
<Checkbox Label=""Subscribe to newsletter"" Checked=""true"" />";

    private string DisabledCode => @"<Checkbox Label=""Disabled unchecked"" Disabled=""true"" />
<Checkbox Label=""Disabled checked"" Checked=""true"" Disabled=""true"" />";

    private string IndeterminateCode => @"<Checkbox Label=""Select all"" Indeterminate=""true"" />
<Checkbox Label=""Some items selected"" Indeterminate=""true"" />";

    private string ChangeHandlerCode => @"<Checkbox Label=""Agree to terms"" @bind-Checked=""@agreed"" />
<p>Agreed: @agreed</p>

@code {
    private bool agreed = false;
}";
}


