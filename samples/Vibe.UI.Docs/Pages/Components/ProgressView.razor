@page "/components/progress"
@using Vibe.UI.Components

<PageTitle>Progress - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Progress</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Progress</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            Displays the progress of an operation or task.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-flex vibe-flex-col vibe-gap-6 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
            <div>
                <div class="vibe-mb-2 vibe-text-sm vibe-text-muted-foreground">25% Complete</div>
                <Progress Value="25" />
            </div>
            <div>
                <div class="vibe-mb-2 vibe-text-sm vibe-text-muted-foreground">50% Complete</div>
                <Progress Value="50" Variant="primary" />
            </div>
            <div>
                <div class="vibe-mb-2 vibe-text-sm vibe-text-muted-foreground">75% Complete</div>
                <Progress Value="75" Variant="success" />
            </div>
            <div>
                <div class="vibe-mb-2 vibe-text-sm vibe-text-muted-foreground">100% Complete</div>
                <Progress Value="100" Variant="success" />
            </div>
            <div>
                <div class="vibe-mb-2 vibe-text-sm vibe-text-muted-foreground">Loading...</div>
                <Progress IndeterminateAnimation="true" />
            </div>
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <!-- Basic Usage -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Basic Usage</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                A simple progress bar showing task completion.
            </p>
            <div class="vibe-flex vibe-flex-col vibe-gap-4 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Progress Value="50" />
                <Progress Value="75" />
            </div>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>

        <!-- With Label -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">With Label</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Pair the progress bar with a visible label while keeping an accessible name on the control.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-flex vibe-items-center vibe-justify-between vibe-mb-2 vibe-text-sm">
                    <span class="vibe-font-medium vibe-text-foreground">Upload progress</span>
                    <span class="vibe-text-muted-foreground">@progress%</span>
                </div>
                <Progress Value="@progress" AriaLabel="Upload progress" />
            </div>
            <CodeBlock Code="@LabelCode" Language="razor" />
        </div>

        <!-- Indeterminate -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Indeterminate</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Use indeterminate state when progress cannot be determined.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Progress IndeterminateAnimation="true" />
            </div>
            <CodeBlock Code="@IndeterminateCode" Language="razor" />
        </div>

        <!-- Variants -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Variants</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Use semantic color variants when progress also communicates status.
            </p>
            <div class="vibe-flex vibe-flex-col vibe-gap-4 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div>
                    <div class="vibe-mb-2 vibe-text-xs vibe-text-muted-foreground">Default</div>
                    <Progress Value="60" />
                </div>
                <div>
                    <div class="vibe-mb-2 vibe-text-xs vibe-text-muted-foreground">Success</div>
                    <Progress Value="60" Variant="success" />
                </div>
                <div>
                    <div class="vibe-mb-2 vibe-text-xs vibe-text-muted-foreground">Warning</div>
                    <Progress Value="60" Variant="warning" />
                </div>
                <div>
                    <div class="vibe-mb-2 vibe-text-xs vibe-text-muted-foreground">Destructive</div>
                    <Progress Value="60" Variant="destructive" />
                </div>
            </div>
            <CodeBlock Code="@StylesCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Value</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="int" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">0</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Progress value (0-100)</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">IndeterminateAnimation</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Animate as indeterminate</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Variant</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">"default"</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Color variant: default, primary, secondary, success, warning, info, error, or destructive</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <p class="vibe-text-muted-foreground vibe-mb-4">
            Install the Progress component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add progress" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <div class="vibe-prose dark:vibe-prose-invert vibe-max-w-none">
            <ul class="vibe-space-y-2 vibe-text-muted-foreground">
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    Uses <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">role="progressbar"</code>
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    Includes aria-valuenow, aria-valuemin, and aria-valuemax attributes
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                    </svg>
                    Screen reader announces progress updates
                </li>
            </ul>
        </div>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/spinner" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Spinner</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Loading spinner indicator</p>
            </a>
            <a href="components/skeleton" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Skeleton</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Loading placeholder</p>
            </a>
        </div>
    </section>
</div>

@code {
    private int progress = 65;

    private string BasicCode => @"<Progress Value=""50"" />
<Progress Value=""75"" />";

    private string LabelCode => @"<div class=""progress-label"">
    <span>Upload progress</span>
    <span>@progress%</span>
</div>
<Progress Value=""@progress"" AriaLabel=""Upload progress"" />

@code {
    private int progress = 65;
}";

    private string IndeterminateCode => @"<Progress IndeterminateAnimation=""true"" />";

    private string StylesCode => @"<Progress Value=""60"" />
<Progress Value=""60"" Variant=""success"" />
<Progress Value=""60"" Variant=""warning"" />
<Progress Value=""60"" Variant=""destructive"" />";
}


