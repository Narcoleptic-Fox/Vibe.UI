@page "/components/slider"
@using Vibe.UI.Docs.Models

<PageTitle>Slider - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Slider</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Slider</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            An input where the user selects a value from within a given range.
        </p>
    </header>

    <!-- Interactive Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Interactive Preview</h2>
        <LivePreview Code="@GeneratedCode" Props="@sliderProps" OnPropChanged="HandlePropChanged" OnPropsReset="HandlePropsReset">
            <PreviewContent>
                <div class="vibe-w-full vibe-max-w-md">
                    <Slider Value="@currentValue"
                            AriaLabel="Preview value"
                            ValueChanged="@((double val) => currentValue = val)"
                            Min="@currentMin"
                            Max="@currentMax"
                            Step="@currentStep"
                            Disabled="@currentDisabled"
                            ShowValue="@currentShowValue" />
                </div>
            </PreviewContent>
        </LivePreview>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <!-- Default -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Default</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                A basic slider with default range (0-100).
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <Slider Label="Volume" Value="@volume" ValueChanged="@((double val) => volume = val)" ShowValue="true" />
                </div>
            </div>
            <CodeBlock Code="@DefaultCode" Language="razor" />
        </div>

        <!-- Custom Range -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Custom Range</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Define custom minimum and maximum values.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <Slider Label="Temperature (°F)" Min="0" Max="200" Value="@temperature" ValueChanged="@((double val) => temperature = val)" ShowValue="true" />
                </div>
            </div>
            <CodeBlock Code="@RangeCode" Language="razor" />
        </div>

        <!-- With Step -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">With Step</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Control the increment granularity with the step property.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md vibe-space-y-4">
                    <div>
                        <Slider Label="Brightness" Min="0" Max="100" Step="10" Value="@brightness" ValueChanged="@((double val) => brightness = val)" ShowValue="true" />
                    </div>
                    <div>
                        <Slider Label="Opacity" Min="0" Max="1" Step="0.1" Value="@opacity" ValueChanged="@((double val) => opacity = val)" ShowValue="true" ValueFormat="0.0" />
                    </div>
                </div>
            </div>
            <CodeBlock Code="@StepCode" Language="razor" />
        </div>

        <!-- Disabled State -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Disabled</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Prevent user interaction with the disabled state.
            </p>
            <div class="vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div class="vibe-max-w-md">
                    <Slider Label="Disabled value" Value="50" Disabled="true" ShowValue="true" />
                </div>
            </div>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Value</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="double" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">0</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Current value of the slider</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Min</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="double" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">0</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Minimum value of the range</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Max</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="double" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">100</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Maximum value of the range</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Step</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="double" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">1</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Step increment for value changes</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Disabled</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the slider is disabled</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ShowValue</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">true</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether to display the current value</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Label</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Visible label associated with the native range input</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">AriaLabel</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Accessible name that takes precedence over Label</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ValueChanged</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<double>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Callback when value changes</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnInput</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<ChangeEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Native input event while the value is changing</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnChange</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<ChangeEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Native change event when the adjustment is committed</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <p class="vibe-text-muted-foreground vibe-mb-4">
            Install the Slider component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add slider" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <div class="vibe-prose dark:vibe-prose-invert vibe-max-w-none">
            <ul class="vibe-space-y-2 vibe-text-muted-foreground">
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Uses semantic <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">&lt;input type="range"&gt;</code> element
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Keyboard accessible (Arrow keys to adjust value, Home/End for min/max)
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    ARIA attributes for current value and range
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Focus visible styles for keyboard users
                </li>
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" Color="var(--vibe-success)" CssClass="vibe-mt-0.5 vibe-shrink-0" />
                    Screen reader announces value changes
                </li>
            </ul>
        </div>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/input" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Input</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Text input component</p>
            </a>
            <a href="components/progress" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Progress</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Progress indicator component</p>
            </a>
            <a href="components/formfield" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">FormField</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Form field wrapper</p>
            </a>
        </div>
    </section>
</div>

@code {
    // Interactive preview state
    private double currentValue = 50;
    private double currentMin = 0;
    private double currentMax = 100;
    private double currentStep = 1;
    private bool currentDisabled = false;
    private bool currentShowValue = true;

    // Example values
    private double volume = 75;
    private double temperature = 98;
    private double brightness = 60;
    private double opacity = 0.8;

    // PropTweaker props
    private List<PropDefinition> sliderProps = new();

    protected override void OnInitialized()
    {
        InitializeProps();
    }

    private void InitializeProps()
    {
        sliderProps = new List<PropDefinition>
        {
            PropDefinition.Number("Value", 50, description: "Current slider value"),
            PropDefinition.Number("Min", 0, description: "Minimum value"),
            PropDefinition.Number("Max", 100, description: "Maximum value"),
            PropDefinition.Number("Step", 1, description: "Step increment"),
            PropDefinition.Boolean("Disabled", false, "Disable the slider"),
            PropDefinition.Boolean("ShowValue", true, "Display current value")
        };
    }

    private void HandlePropChanged(PropDefinition prop)
    {
        switch (prop.Name)
        {
            case "Value":
                if (double.TryParse(prop.Value?.ToString(), out var value))
                    currentValue = value;
                break;
            case "Min":
                if (double.TryParse(prop.Value?.ToString(), out var min))
                    currentMin = min;
                break;
            case "Max":
                if (double.TryParse(prop.Value?.ToString(), out var max))
                    currentMax = max;
                break;
            case "Step":
                if (double.TryParse(prop.Value?.ToString(), out var step))
                    currentStep = step;
                break;
            case "Disabled":
                currentDisabled = prop.Value is true || prop.Value?.ToString()?.ToLower() == "true";
                break;
            case "ShowValue":
                currentShowValue = prop.Value is true || prop.Value?.ToString()?.ToLower() == "true";
                break;
        }
        StateHasChanged();
    }

    private void HandlePropsReset()
    {
        currentValue = 50;
        currentMin = 0;
        currentMax = 100;
        currentStep = 1;
        currentDisabled = false;
        currentShowValue = true;
        InitializeProps();
        StateHasChanged();
    }

    private string GeneratedCode
    {
        get
        {
            var props = new List<string> { "AriaLabel=\"Preview value\"" };

            if (currentValue != 0)
                props.Add($"Value=\"{currentValue}\"");
            if (currentMin != 0)
                props.Add($"Min=\"{currentMin}\"");
            if (currentMax != 100)
                props.Add($"Max=\"{currentMax}\"");
            if (currentStep != 1)
                props.Add($"Step=\"{currentStep}\"");
            if (currentDisabled)
                props.Add("Disabled=\"true\"");
            if (!currentShowValue)
                props.Add("ShowValue=\"false\"");

            var propsStr = props.Any() ? " " + string.Join(" ", props) : "";
            return $"<Slider{propsStr} />";
        }
    }

    private string DefaultCode => @"<Slider Label=""Volume""
        Value=""@volume""
        ValueChanged=""@((double val) => volume = val)"" />

@code {
    private double volume = 75;
}";

    private string RangeCode => @"<Slider Label=""Temperature (°F)"" Min=""0"" Max=""200"" Value=""@temperature"" ValueChanged=""@((double val) => temperature = val)"" />

<Slider AriaLabel=""Offset"" Min=""-50"" Max=""50"" Value=""0"" />

@code {
    private double temperature = 98;
}";

    private string StepCode => @"<Slider Label=""Brightness"" Step=""10"" Value=""@brightness"" ValueChanged=""@((double val) => brightness = val)"" />

<Slider Label=""Opacity"" Step=""0.1"" Min=""0"" Max=""1"" Value=""@opacity"" ValueChanged=""@((double val) => opacity = val)"" ValueFormat=""0.0"" />

@code {
    private double brightness = 60;
    private double opacity = 0.8;
}";

    private string DisabledCode => @"<Slider Label=""Disabled value"" Value=""50"" Disabled=""true"" />";
}


