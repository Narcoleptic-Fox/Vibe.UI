@page "/components/togglegroup"

<PageTitle>Toggle Group - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Toggle Group</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Toggle Group</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A compact set of two-state buttons for choosing one or several options.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
            <ToggleGroup @bind-Value="alignment" AriaLabel="Text alignment" />
            <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-muted-foreground">Alignment: @(alignment?.ToString() ?? "None")</output>
        </div>
        <div class="vibe-mt-4">
            <CodeBlock Code="@SingleCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Multiple selection</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                With <code>Type="ToggleGroupType.Multiple"</code>, bind a list with
                <code>@@bind-Values</code>. Each pressed item adds its enum value to the list.
            </p>
            <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3" data-testid="toggle-enum-formats">
                <ToggleGroup Type="ToggleGroupType.Multiple"
                             @bind-Values="formats"
                             AriaLabel="Text formatting" />
                <output id="toggle-enum-formats-value" class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-muted-foreground">Active: @(formats.Count == 0 ? "None" : string.Join(", ", formats))</output>
            </div>
            <CodeBlock Code="@MultipleCode" Language="razor" />
        </div>

        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Vertical, with an item disabled</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Write the items to disable one or to choose the labels. Each item's value is the
                enum value itself.
            </p>
            <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <ToggleGroup Orientation="ToggleGroupOrientation.Vertical"
                             @bind-Value="density"
                             AriaLabel="Display density">
                    <ToggleGroupItem Value="Density.Compact">Compact</ToggleGroupItem>
                    <ToggleGroupItem Value="Density.Comfortable">Comfortable</ToggleGroupItem>
                    <ToggleGroupItem Value="Density.Spacious" Disabled="true">Spacious (coming soon)</ToggleGroupItem>
                </ToggleGroup>
            </div>
            <CodeBlock Code="@VerticalCode" Language="razor" />
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Sizes</h3>
            <div class="vibe-flex vibe-flex-col vibe-items-start vibe-gap-4 vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
                @foreach (var size in Sizes)
                {
                    <ToggleGroup Size="size" Value="CalendarRange.Week" AriaLabel="@($"{size} calendar range")" />
                }
            </div>
        </div>

        <div class="vibe-mt-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Clearing, and other types</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Pressing the selected item of a single group clears it only when the bound type can
                be null: a nullable enum goes back to <code>null</code>, while an <code>int</code>
                keeps its value. Numbers bind the same way as enums, with the items written out.
            </p>
            <div class="vibe-flex vibe-flex-col vibe-items-start vibe-gap-4 vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <div data-testid="toggle-typed-enum">
                    <ToggleGroup @bind-Value="typedAlignment" AriaLabel="Alignment" />
                </div>
                <div data-testid="toggle-typed-days">
                    <ToggleGroup Type="ToggleGroupType.Multiple" @bind-Values="typedDays" AriaLabel="Working days" />
                </div>
                <div data-testid="toggle-typed-int">
                    <ToggleGroup @bind-Value="typedPageSize" AriaLabel="Rows per page">
                        <ToggleGroupItem Value="10">10</ToggleGroupItem>
                        <ToggleGroupItem Value="25">25</ToggleGroupItem>
                        <ToggleGroupItem Value="50">50</ToggleGroupItem>
                    </ToggleGroup>
                </div>
                <p id="toggle-typed-readout" class="vibe-text-sm vibe-text-muted-foreground">
                    alignment = @(typedAlignment?.ToString() ?? "null") · days = @string.Join(", ", typedDays) · page size = @typedPageSize
                </p>
            </div>
            <CodeBlock Code="@TypedCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">ToggleGroup API</h2>
        <div class="vibe-overflow-x-auto" tabindex="0">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-border">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in GroupProperties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">ToggleGroupItem API</h2>
        <div class="vibe-overflow-x-auto" tabindex="0">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-border">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in ItemProperties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add togglegroup" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            <li>Each item exposes its state through <code>aria-pressed</code>.</li>
            <li>Only one enabled item is in the tab order at a time.</li>
            <li>Arrow keys follow the configured orientation and wrap between enabled items.</li>
            <li>Home and End move focus to the first and last enabled items.</li>
        </ul>
    </section>
</div>

@code {
    private enum TextAlign { Left, Center, Right, Justify }
    private enum TextStyle { Bold, Italic, Underline, Strikethrough, Code }
    private enum Density { Compact, Comfortable, Spacious }
    private enum CalendarRange { Day, Week, Month }

    private TextAlign? alignment = TextAlign.Left;
    private List<TextStyle> formats = [TextStyle.Bold];
    private Density density = Density.Comfortable;

    private static readonly ToggleGroupSize[] Sizes =
    [
        ToggleGroupSize.Small,
        ToggleGroupSize.Default,
        ToggleGroupSize.Large
    ];

    private static readonly (string Name, string Type, string Default, string Description)[] GroupProperties =
    [
        ("ChildContent", "RenderFragment?", "null", "ToggleGroupItem content. Optional when TValue is an enum: one item per value is built"),
        ("Type", "ToggleGroupType", "Single", "Single or Multiple selection behavior"),
        ("Value", "TValue?", "default", "Selected value in Single mode; supports @bind-Value. An enum, number, bool, Guid or string, or a nullable form"),
        ("Values", "List<TValue>", "empty", "Selected values in Multiple mode; supports @bind-Values"),
        ("ValueChanged", "EventCallback<TValue?>", "-", "Raised when the Single value changes"),
        ("ValuesChanged", "EventCallback<List<TValue>>", "-", "Raised with a new list when Multiple values change"),
        ("Disabled", "bool", "false", "Disables every item"),
        ("Orientation", "ToggleGroupOrientation", "Horizontal", "Horizontal or Vertical keyboard axis"),
        ("Size", "ToggleGroupSize", "Default", "Small, Default, or Large target size"),
        ("AriaLabel", "string?", "null", "Accessible name for the group"),
        ("CssClass", "string?", "null", "Additional group CSS class")
    ];

    private static readonly (string Name, string Type, string Default, string Description)[] ItemProperties =
    [
        ("ChildContent", "RenderFragment?", "null", "Visible item content"),
        ("Value", "TValue", "default", "This item's value, as a C# expression of the group's type: Value=\"Density.Compact\" or Value=\"25\""),
        ("Disabled", "bool", "false", "Disables this item"),
        ("CssClass", "string?", "null", "Additional item CSS class")
    ];

    private const string SingleCode = """
        <ToggleGroup @bind-Value="alignment" AriaLabel="Text alignment" />

        @code {
            private enum TextAlign { Left, Center, Right, Justify }

            private TextAlign? alignment = TextAlign.Left;   // one item per value; press again to clear
        }
        """;

    private const string MultipleCode = """
        <ToggleGroup Type="ToggleGroupType.Multiple" @bind-Values="formats" AriaLabel="Text formatting" />

        @code {
            private enum TextStyle { Bold, Italic, Underline, Strikethrough, Code }

            private List<TextStyle> formats = [TextStyle.Bold];
        }
        """;

    private enum TextAlignment { Left, Center, Right }

    private TextAlignment? typedAlignment = TextAlignment.Left;
    private List<DayOfWeek> typedDays = [DayOfWeek.Monday, DayOfWeek.Wednesday];
    private int typedPageSize = 25;

    private const string TypedCode = """
        <ToggleGroup @bind-Value="alignment" AriaLabel="Alignment" />

        <ToggleGroup Type="ToggleGroupType.Multiple" @bind-Values="days" AriaLabel="Working days" />

        <ToggleGroup @bind-Value="pageSize" AriaLabel="Rows per page">
            <ToggleGroupItem Value="10">10</ToggleGroupItem>
            <ToggleGroupItem Value="25">25</ToggleGroupItem>
            <ToggleGroupItem Value="50">50</ToggleGroupItem>
        </ToggleGroup>

        @code {
            private enum TextAlignment { Left, Center, Right }

            private TextAlignment? alignment = TextAlignment.Left;   // press again to clear
            private List<DayOfWeek> days = [DayOfWeek.Monday, DayOfWeek.Wednesday];
            private int pageSize = 25;                               // always has a value
        }
        """;

    private const string VerticalCode = """
        <ToggleGroup Orientation="ToggleGroupOrientation.Vertical"
                     @bind-Value="density"
                     AriaLabel="Display density">
            <ToggleGroupItem Value="Density.Compact">Compact</ToggleGroupItem>
            <ToggleGroupItem Value="Density.Comfortable">Comfortable</ToggleGroupItem>
            <ToggleGroupItem Value="Density.Spacious" Disabled="true">Spacious (coming soon)</ToggleGroupItem>
        </ToggleGroup>

        @code {
            private enum Density { Compact, Comfortable, Spacious }

            private Density density = Density.Comfortable;
        }
        """;
}
