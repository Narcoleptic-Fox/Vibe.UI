@page "/components/formfield"
@using Vibe.UI.Components

<PageTitle>FormField - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./">Docs</a><span>/</span><a href="components">Components</a><span>/</span>
            <span class="vibe-text-foreground">FormField</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">FormField</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            Associates one control with its label, description, required state, and validation message.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
            <div class="vibe-max-w-md vibe-space-y-4">
                <FormField TValue="string"
                           Id="work-email"
                           Label="Work email"
                           Description="We use this for account notifications"
                           ErrorMessage="@(showError ? "Enter a valid work email" : null)"
                           Required="true">
                    <Input Type="email" Placeholder="you@company.com" @bind-Value="email" />
                </FormField>
                <Button OnClick="@ToggleError">@(showError ? "Clear error" : "Show error")</Button>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Description and required state</h3>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">EditContext validation</h3>
            <CodeBlock Code="@ValidationCode" Language="razor" />
        </div>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Label and required marker from the model</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                Given <code>For</code>, whatever the line leaves unset comes from the property:
                the label, the description and the required marker. Anything set on the line wins,
                and an empty string shows none. This is the wrapper <code>PropertyInput</code>
                uses, around a control you choose.
            </p>
            <CodeBlock Code="@MetadataCode" Language="razor" />
        </div>
        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">A control of your own</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                The field cascades a <code>FormFieldContext</code>. A control that reads it gets
                the id the label points at, the ids of the description and the message, and
                whether the field is invalid or required.
            </p>
            <CodeBlock Code="@OwnControlCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto" tabindex="0">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-border">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add formfield" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private string email = string.Empty;
    private bool showError;

    private void ToggleError() => showError = !showError;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("Id", "string?", "generated", "Shared ID for the label and nested Vibe control"),
        ("Label", "string?", "from For", "Visible control label. An empty string shows none"),
        ("Description", "string?", "from For", "Help text linked to the control. An empty string shows none"),
        ("ErrorMessage", "string?", "null", "Explicit error linked and announced for the control"),
        ("For", "Expression<Func<TValue>>?", "null", "The property the field is for. Its validation messages are shown, and its metadata fills what the line leaves unset"),
        ("HasError", "bool", "false", "Force the invalid visual and ARIA state"),
        ("Required", "bool?", "from For", "Render a required marker and mark the nested control required. From the model, a bool is never marked"),
        ("ChildContent", "RenderFragment?", "null", "Input, Select, or TextArea content")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "The label for attribute matches the nested control ID",
        "Description and errors are applied to the control with aria-describedby",
        "Invalid controls expose aria-invalid and aria-errormessage",
        "Required state is visible and applied to the native control"
    ];

    private string BasicCode => @"<FormField TValue=""string""
           Id=""email""
           Label=""Email""
           Description=""Used for account notifications""
           Required=""true"">
    <Input Type=""email"" @bind-Value=""model.Email"" />
</FormField>";

    private string ValidationCode => @"<Form Model=""model"">
    <FormField TValue=""string""
               Id=""email""
               Label=""Email""
               For=""@(() => model.Email)"">
        <Input Type=""email"" @bind-Value=""model.Email"" />
    </FormField>
</Form>";

    private string MetadataCode => @"<Form Model=""model"">
    @* [Required, Display(Name = ""Work email"", Description = ""We never share it."")] *@
    <FormField For=""() => model.Email"">
        <Input Type=""email"" @bind-Value=""model.Email"" />
    </FormField>

    <FormField For=""() => model.Country"" Label=""Ships to"">
        <Combobox Options=""countries"" @bind-Value=""model.Country"" />
    </FormField>
</Form>";

    private string OwnControlCode => @"<button type=""button"" id=""@Field?.ControlId""
        aria-describedby=""@Field?.DescribedBy""
        aria-invalid=""@(Field?.IsInvalid == true ? ""true"" : null)"">
    @Value
</button>

@code {
    [CascadingParameter]
    private FormFieldContext? Field { get; set; }

    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
}";
}
