@page "/components/combobox"
@using Vibe.UI.Components

<PageTitle>Combobox - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./">Docs</a><span>/</span><a href="components">Components</a><span>/</span>
            <span class="vibe-text-foreground">Combobox</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Combobox</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A text box with a filtered list of options. Type to narrow the list, then pick one with
            the mouse or the keyboard.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
            <div class="vibe-max-w-md vibe-space-y-2">
                <label for="combobox-framework" class="vibe-block vibe-text-sm vibe-font-medium vibe-text-foreground">Framework</label>
                <Combobox Id="combobox-framework" Options="frameworks" Placeholder="Choose a framework"
                          HelperText="Type to filter the list" @bind-Value="framework" />
                <output id="combobox-framework-value" class="vibe-block vibe-text-sm vibe-text-muted-foreground">
                    Value: @Show(framework)
                </output>
            </div>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <div class="vibe-mb-10">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Text options</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                Each <code>ComboboxOption</code> has the text shown and the value reported. The value
                in the preview above is a <code>string</code>. A <code>string?</code> field binds to
                <code>ComboboxOption&lt;string&gt;</code> options as written: the field can be empty, the
                options cannot, and <code>TValue</code> does not need stating.
            </p>
            <CodeBlock Code="@StringCode" Language="razor" />
        </div>

        <div class="vibe-mb-10">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Typed values</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                The value takes the type of the options, here a <code>Guid?</code>. Picking an option
                reports its value as it is, with no conversion through text. Because the type is
                nullable, emptying the box sets the value back to <code>null</code>.
            </p>
            <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-4">
                <div class="vibe-max-w-md vibe-space-y-2">
                    <label for="combobox-owner" class="vibe-block vibe-text-sm vibe-font-medium vibe-text-foreground">Owner</label>
                    <Combobox Id="combobox-owner" Options="owners" Placeholder="Anyone" @bind-Value="ownerId" />
                    <output id="combobox-owner-value" class="vibe-block vibe-text-sm vibe-text-muted-foreground">
                        Value: @Show(ownerId)
                    </output>
                </div>
            </div>
            <CodeBlock Code="@TypedCode" Language="razor" />
        </div>

        <div class="vibe-mb-10">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Enum options</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                Bound to an enum with no <code>Options</code> given, the combobox lists the enum's
                values. Each label is the value's name split into words, so <code>InProgress</code>
                shows as "In progress".
            </p>
            <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-4">
                <div class="vibe-max-w-md vibe-space-y-2">
                    <label for="combobox-state" class="vibe-block vibe-text-sm vibe-font-medium vibe-text-foreground">State</label>
                    <Combobox Id="combobox-state" Placeholder="Any state" @bind-Value="state" />
                    <output id="combobox-state-value" class="vibe-block vibe-text-sm vibe-text-muted-foreground">
                        Value: @(state is null ? "null" : $"TaskState.{state}")
                    </output>
                </div>
            </div>
            <CodeBlock Code="@EnumCode" Language="razor" />
        </div>

        <div>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Free text and clearing</h3>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                With <code>AllowFreeText</code>, pressing Enter on text that matches no option uses the
                text itself. It is converted to the value's type in the invariant culture, so the page
                size below accepts "40", and text that is not a number is ignored rather than reported.
            </p>
            <p class="vibe-text-muted-foreground vibe-mb-3">
                <code>Clearable</code> decides whether emptying the box sets the value to nothing. It is
                on by default for a nullable value type such as <code>int?</code> or a nullable enum,
                and off otherwise, so a <code>string</code> needs it set.
            </p>
            <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-4">
                <div class="vibe-grid vibe-gap-6 sm:vibe-grid-cols-2">
                    <div class="vibe-space-y-2">
                        <label for="combobox-page-size" class="vibe-block vibe-text-sm vibe-font-medium vibe-text-foreground">Page size</label>
                        <Combobox Id="combobox-page-size" Options="pageSizes" AllowFreeText="true" @bind-Value="pageSize" />
                        <output id="combobox-page-size-value" class="vibe-block vibe-text-sm vibe-text-muted-foreground">
                            Value: @pageSize
                        </output>
                    </div>
                    <div class="vibe-space-y-2">
                        <label for="combobox-city" class="vibe-block vibe-text-sm vibe-font-medium vibe-text-foreground">City</label>
                        <Combobox Id="combobox-city" Options="cities" AllowFreeText="true" Clearable="true"
                                  Placeholder="Any city" @bind-Value="city" />
                        <output id="combobox-city-value" class="vibe-block vibe-text-sm vibe-text-muted-foreground">
                            Value: @Show(city)
                        </output>
                    </div>
                </div>
            </div>
            <CodeBlock Code="@FreeTextCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>
        <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Combobox&lt;TValue&gt;</h3>
        <p class="vibe-text-muted-foreground vibe-mb-3">
            <code>TValue</code> is inferred from <code>Options</code> or from <code>@@bind-Value</code>.
            A combobox with neither, such as one with no options yet and no binding, needs it stated:
            <code>TValue="string"</code>.
        </p>
        <div class="vibe-overflow-x-auto vibe-mb-8" tabindex="0">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-border">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">ComboboxOption&lt;TValue&gt;</h3>
        <p class="vibe-text-muted-foreground vibe-mb-3">
            A class of its own in <code>Vibe.UI.Components</code>, not nested inside
            <code>Combobox</code>, so it is written <code>ComboboxOption&lt;Guid?&gt;</code>.
        </p>
        <div class="vibe-overflow-x-auto" tabindex="0">
            <table class="vibe-w-full vibe-text-sm">
                <thead><tr class="vibe-border-b vibe-border-border">
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Name</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Type</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Default</th>
                    <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium">Description</th>
                </tr></thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in OptionProperties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add combobox" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private enum TaskState
    {
        NotStarted,
        InProgress,
        Blocked,
        Done
    }

    private string? framework;
    private Guid? ownerId;
    private TaskState? state;
    private int pageSize = 25;
    private string? city;

    private readonly List<ComboboxOption<string>> frameworks =
    [
        new() { Label = "Blazor", Value = "blazor" },
        new() { Label = "React", Value = "react" },
        new() { Label = "Vue", Value = "vue" },
        new() { Label = "Svelte", Value = "svelte" },
        new() { Label = "Angular", Value = "angular" },
    ];

    private readonly List<ComboboxOption<Guid?>> owners =
    [
        new() { Label = "Ana Silva", Value = new Guid("6f1c2b0e-0d6a-4c1e-9a52-1b7d3e0a4c11") },
        new() { Label = "Kenji Mori", Value = new Guid("0b9e4a77-5c2d-4f8e-8b13-6a2e9d1c7f42") },
        new() { Label = "Priya Nair", Value = new Guid("c43d8e19-7a0b-4b6d-a2f5-9e1b0c6d3a83") },
    ];

    private readonly List<ComboboxOption<int>> pageSizes =
    [
        new() { Label = "10", Value = 10 },
        new() { Label = "25", Value = 25 },
        new() { Label = "50", Value = 50 },
    ];

    private readonly List<ComboboxOption<string>> cities =
    [
        new() { Label = "Lisbon", Value = "Lisbon" },
        new() { Label = "Osaka", Value = "Osaka" },
        new() { Label = "Toronto", Value = "Toronto" },
    ];

    private static string Show<T>(T? value) => value is null ? "null" : value.ToString()!;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("TValue", "type parameter", "inferred", "Type of the value; inferred from Options or @bind-Value, otherwise set it, such as TValue=\"string\""),
        ("Options", "IReadOnlyList<IComboboxOption<TValue>>?", "null", "The choices, usually a List<ComboboxOption<TValue>>. When omitted and TValue is an enum or nullable enum, one option per enum value"),
        ("Value", "TValue?", "default", "The selected value; supports @bind-Value"),
        ("ValueChanged", "EventCallback<TValue?>", "none", "Called when the value changes"),
        ("AllowFreeText", "bool", "false", "Enter on text that matches no option reports the text, converted to TValue in the invariant culture; text that does not convert is ignored"),
        ("Clearable", "bool?", "true for nullable value types", "Emptying the box sets the value to default"),
        ("Placeholder", "string", "\"Select an option...\"", "Text shown in the empty box"),
        ("Id", "string?", "generated", "ID of the text box, for a label's for attribute"),
        ("HelperText", "string?", "null", "Help shown under the box when there is no error, linked with aria-describedby"),
        ("ErrorMessage", "string?", "null", "Error shown under the box; marks it invalid"),
        ("EmptyText", "string", "\"No results found.\"", "Shown in the list when nothing matches"),
        ("Disabled", "bool", "false", "Disable the combobox"),
        ("ReadOnly", "bool", "false", "Show the value without allowing changes"),
        ("Required", "bool", "false", "Mark the value as required"),
        ("AriaLabel", "string?", "null", "Accessible name when there is no visible label"),
        ("AriaLabelledBy", "string?", "null", "ID of an element that labels the box"),
        ("AriaDescribedBy", "string?", "null", "Extra IDs that describe the box"),
    ];

    private static readonly (string Name, string Type, string Default, string Description)[] OptionProperties =
    [
        ("Label", "string", "\"\"", "Text shown in the list and matched against what is typed"),
        ("Value", "TValue?", "default", "Value reported when the option is picked"),
        ("Disabled", "bool", "false", "Leaves the option out of the list"),
    ];

    private static readonly string[] AccessibilityItems =
    [
        "The text box has the combobox role and controls a listbox of options",
        "Arrow keys move through the options, Enter picks one, and Escape closes the list",
        "The highlighted option is announced through aria-activedescendant",
        "Helper text and error messages are linked with aria-describedby",
        "There is no built-in visible label: use a label element pointing at Id, or AriaLabel",
    ];

    private const string StringCode = """
        <label for="framework">Framework</label>
        <Combobox Id="framework" Options="frameworks" Placeholder="Choose a framework" @bind-Value="framework" />

        @code {
            private string? framework;

            private readonly List<ComboboxOption<string>> frameworks =
            [
                new() { Label = "Blazor", Value = "blazor" },
                new() { Label = "React", Value = "react" },
                new() { Label = "Vue", Value = "vue" },
            ];
        }
        """;

    private const string TypedCode = """
        <label for="owner">Owner</label>
        <Combobox Id="owner" Options="owners" Placeholder="Anyone" @bind-Value="ownerId" />

        @code {
            private Guid? ownerId;   // nullable: emptying the box sets it back to null

            private List<ComboboxOption<Guid?>> owners = users
                .Select(user => new ComboboxOption<Guid?> { Label = user.Name, Value = user.Id })
                .ToList();
        }
        """;

    private const string EnumCode = """
        <label for="state">State</label>
        <Combobox Id="state" Placeholder="Any state" @bind-Value="state" />

        @code {
            private enum TaskState { NotStarted, InProgress, Blocked, Done }

            private TaskState? state;   // options: Not started, In progress, Blocked, Done
        }
        """;

    private const string FreeTextCode = """
        <Combobox Id="page-size" Options="pageSizes" AllowFreeText="true" @bind-Value="pageSize" />

        <Combobox Id="city" Options="cities" AllowFreeText="true" Clearable="true"
                  Placeholder="Any city" @bind-Value="city" />

        @code {
            private int pageSize = 25;   // typing 40 and Enter sets 40; "abc" is ignored
            private string? city;        // Clearable: emptying the box sets null
        }
        """;
}
