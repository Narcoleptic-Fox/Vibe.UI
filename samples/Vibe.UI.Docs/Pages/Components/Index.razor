@page "/components"

<PageTitle>Components - Vibe.UI</PageTitle>

<div class="vibe-max-w-6xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-12">
        <h1 class="vibe-text-4xl vibe-font-bold vibe-text-foreground vibe-mb-4">Components</h1>
        <p class="vibe-text-xl vibe-text-muted-foreground vibe-max-w-3xl">
            Beautifully designed components built with Blazor and Vibe.UI.CSS utilities.
            Copy and paste into your apps. Open source.
        </p>
    </header>

    <!-- Search -->
    <div class="vibe-mb-8">
        <div class="vibe-relative vibe-max-w-md">
            <svg class="vibe-absolute vibe-left-3 vibe-top-1/2 vibe--translate-y-1/2 vibe-w-5 vibe-h-5 vibe-text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <input type="text"
                   placeholder="Search components..."
                   @bind="searchQuery"
                   @bind:event="oninput"
                   class="vibe-w-full vibe-pl-10 vibe-pr-4 vibe-py-2.5 vibe-rounded-lg vibe-border vibe-border-border vibe-bg-card vibe-text-foreground placeholder:vibe-text-muted-foreground focus:vibe-outline-none focus:vibe-ring-2 focus:vibe-ring-ring focus:vibe-border-transparent" />
        </div>
    </div>

    <!-- Component Categories -->
    @foreach (var category in FilteredCategories)
    {
        <section class="vibe-mb-12">
            <h2 class="vibe-text-2xl vibe-font-semibold vibe-text-foreground vibe-mb-2">@category.Name</h2>
            <p class="vibe-text-muted-foreground vibe-mb-6">@category.Description</p>

            <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-2 lg:vibe-grid-cols-3 vibe-gap-4">
                @foreach (var component in category.Components.Where(c => MatchesSearch(c)))
                {
                    <a href="@component.RelativeRoute"
                       data-component-route="@component.Route"
                       class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-bg-card hover:vibe-bg-accent vibe-transition-all hover:vibe-shadow-md">
                        <div class="vibe-flex vibe-items-start vibe-justify-between vibe-mb-2">
                            <h3 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link vibe-transition-colors">
                                @component.Name
                            </h3>
                            @if (component.IsNew)
                            {
                                <Badge Variant="default" class="vibe-text-xs">New</Badge>
                            }
                        </div>
                        <p class="vibe-text-sm vibe-text-muted-foreground vibe-line-clamp-2">@component.Description</p>
                    </a>
                }
            </div>
        </section>
    }

    @if (!FilteredCategories.Any())
    {
        <div class="vibe-text-center vibe-py-12">
            <svg class="vibe-w-16 vibe-h-16 vibe-mx-auto vibe-text-muted-foreground vibe-mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-2">No components found</h3>
            <p class="vibe-text-muted-foreground">Try adjusting your search query</p>
        </div>
    }
</div>

@code {
    private string searchQuery = string.Empty;

    private bool MatchesSearch(ComponentPage component)
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            return true;
        }

        return component.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
               component.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase);
    }

    private IEnumerable<ComponentCategory> FilteredCategories =>
        DocsCatalog.Categories.Where(category => category.Components.Any(MatchesSearch));
}
