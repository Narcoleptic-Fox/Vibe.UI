@page "/components/sidebar"
@using Vibe.UI.Components

<PageTitle>Sidebar - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Sidebar</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Sidebar</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A collapsible and optionally resizable navigation region.
        </p>
    </header>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-4 sm:vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border">
            <div class="vibe-overflow-x-auto vibe-rounded-md vibe-border vibe-border-border">
                <div class="vibe-flex" style="min-width: 36rem; height: 20rem;">
                    <Sidebar @bind-IsOpen="sidebarOpen"
                             @bind-Width="sidebarWidth"
                             Title="Workspace"
                             Resizable="true"
                             PersistState="false"
                             MinWidth="180"
                             MaxWidth="320"
                             CollapsedWidth="52">
                        <ChildContent>
                            <nav aria-label="Workspace navigation" class="vibe-grid vibe-gap-1">
                                <a href="#overview" class="vibe-rounded-md vibe-px-3 vibe-py-2 vibe-text-sm vibe-bg-muted">Overview</a>
                                <a href="#components" class="vibe-rounded-md vibe-px-3 vibe-py-2 vibe-text-sm">Components</a>
                                <a href="#releases" class="vibe-rounded-md vibe-px-3 vibe-py-2 vibe-text-sm">Releases</a>
                            </nav>
                        </ChildContent>
                        <Footer>
                            <span class="vibe-text-sm vibe-text-muted-foreground">Product platform</span>
                        </Footer>
                    </Sidebar>
                    <main class="vibe-min-w-0 vibe-flex-1 vibe-p-4 vibe-bg-card">
                        <h3 class="vibe-font-semibold vibe-mb-2">Overview</h3>
                        <p class="vibe-text-sm vibe-text-muted-foreground">
                            The workspace remains stable while the navigation width changes.
                        </p>
                    </main>
                </div>
            </div>
            <output class="vibe-block vibe-mt-3 vibe-text-sm vibe-text-muted-foreground">
                Sidebar: @(sidebarOpen ? $"{sidebarWidth}px" : "collapsed")
            </output>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Bindable state and width</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Bind the open state and width when the containing layout needs both values.
            </p>
            <CodeBlock Code="@BasicCode" Language="razor" />
        </div>
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Surface</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                A sidebar is a panel on the card level by default, like an app bar. Use
                <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">Page</code> for a quiet rail of links with no
                panel of its own, or
                <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">Sunken</code> for a recessed tool panel.
            </p>
            <div class="vibe-grid vibe-grid-cols-1 md:vibe-grid-cols-3 vibe-gap-4 vibe-mb-4" data-testid="sidebar-surfaces">
                @foreach (var surface in Enum.GetValues<Sidebar.SidebarSurface>())
                {
                    <div class="vibe-h-40 vibe-flex vibe-overflow-hidden vibe-rounded-lg vibe-border vibe-border-border">
                        <Sidebar Surface="@surface" Title="@surface.ToString()" Collapsible="false" Width="160" MinWidth="120"
                                 PersistState="false" AriaLabel="@($"{surface} surface example")">
                            <p class="vibe-px-3 vibe-text-sm vibe-text-muted-foreground">Navigation</p>
                        </Sidebar>
                    </div>
                }
            </div>
            <CodeBlock Code="@SurfaceCode" Language="razor" />
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>
        <div class="vibe-overflow-x-auto">
            <table class="vibe-w-full vibe-text-sm">
                <thead>
                    <tr class="vibe-border-b vibe-border-border">
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Default</th>
                        <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                    </tr>
                </thead>
                <tbody class="vibe-divide-y vibe-divide-border">
                    @foreach (var property in Properties)
                    {
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">@property.Name</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="@property.Type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">@property.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <CodeBlock Code="vibe add sidebar" Language="bash" />
    </section>

    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            @foreach (var item in AccessibilityItems)
            {
                <li class="vibe-flex vibe-items-start vibe-gap-2">
                    <Vibe.UI.Components.Icon Name="check-circle" Size="20" CssClass="vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" />
                    @item
                </li>
            }
        </ul>
    </section>
</div>

@code {
    private bool sidebarOpen = true;
    private int sidebarWidth = 220;

    private const string SurfaceCode = """
        <Sidebar Surface="Sidebar.SidebarSurface.Page" Title="Docs">
            ...
        </Sidebar>
        """;

    private static readonly (string Name, string Type, string Default, string Description)[] Properties =
    [
        ("IsOpen", "bool", "true", "Expanded or collapsed state; supports @bind-IsOpen"),
        ("Width", "int", "280", "Expanded width in pixels; supports @bind-Width"),
        ("CollapsedWidth", "int", "60", "Collapsed rail width in pixels"),
        ("MinWidth", "int", "200", "Minimum resizable width"),
        ("MaxWidth", "int", "600", "Maximum resizable width"),
        ("Position", "SidebarPosition", "Left", "Left or Right edge behavior"),
        ("Surface", "SidebarSurface", "Card", "Level of the page it is drawn on: Card, Page or Sunken"),
        ("Collapsible", "bool", "true", "Render the collapse control"),
        ("Resizable", "bool", "false", "Render pointer and keyboard resize controls"),
        ("Disabled", "bool", "false", "Block collapse and resize interactions"),
        ("PersistState", "bool", "true", "Persist width in local storage"),
        ("PersistenceKey", "string?", "null", "Optional stable local-storage key suffix"),
        ("Title", "string?", "null", "Default header title and accessible name"),
        ("Header", "RenderFragment?", "null", "Custom header content"),
        ("ChildContent", "RenderFragment?", "null", "Sidebar navigation or tools"),
        ("Footer", "RenderFragment?", "null", "Footer content")
    ];

    private static readonly string[] AccessibilityItems =
    [
        "Exposes a named complementary region and a named content region",
        "Makes collapsed content inert so hidden links leave the tab order",
        "Exposes current, minimum, and maximum width on the resize separator",
        "Mirrors ArrowLeft and ArrowRight resizing for right-positioned sidebars"
    ];

    private string BasicCode => @"<Sidebar @bind-IsOpen=""isOpen""
         @bind-Width=""width""
         Title=""Workspace""
         Resizable=""true""
         PersistenceKey=""primary-workspace"">
    <WorkspaceNavigation />
</Sidebar>";
}
