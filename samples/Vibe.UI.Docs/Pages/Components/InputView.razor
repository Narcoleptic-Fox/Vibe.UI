@page "/components/input"

<PageTitle>Input - Vibe.UI</PageTitle>

<div class="vibe-max-w-4xl vibe-mx-auto">
    <!-- Header -->
    <header class="vibe-mb-8">
        <div class="vibe-flex vibe-items-center vibe-gap-2 vibe-text-sm vibe-text-muted-foreground vibe-mb-2">
            <a href="./" class="hover:vibe-text-foreground">Docs</a>
            <span>/</span>
            <a href="components" class="hover:vibe-text-foreground">Components</a>
            <span>/</span>
            <span class="vibe-text-foreground">Input</span>
        </div>
        <h1 class="vibe-text-3xl vibe-font-bold vibe-text-foreground vibe-mb-3">Input</h1>
        <p class="vibe-text-lg vibe-text-muted-foreground">
            A text input field for user text entry with multiple variants and features.
        </p>
    </header>

    <!-- Preview -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Preview</h2>
        <div class="vibe-p-6 vibe-rounded-xl vibe-border vibe-border-border vibe-bg-card vibe-space-y-6">
            <div class="vibe-space-y-3">
                <Input TValue="string" Label="Username" Placeholder="Enter your username" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Email" Type="email" Placeholder="you@example.com" Variant="InputVariant.Outlined" HelperText="We'll never share your email" />
                <Input TValue="string" Label="Search" Placeholder="Search..." LeadingIcon="🔍" Size="ComponentSize.Small" Variant="InputVariant.Outlined" />
            </div>
        </div>
    </section>

    <!-- Examples Section -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">Examples</h2>

        <!-- Variants -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Variants</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Choose from three visual styles: text (underline only), filled (muted background), or outlined (full border).
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Text Variant" Placeholder="Underline only" Variant="InputVariant.Text" />
                <Input TValue="string" Label="Filled Variant" Placeholder="Muted background" Variant="InputVariant.Filled" />
                <Input TValue="string" Label="Outlined Variant" Placeholder="Full vibe-border" Variant="InputVariant.Outlined" />
            </div>
            <CodeBlock Code="@VariantsCode" Language="razor" />
        </div>

        <!-- Input Types -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Input Types</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Support for all standard HTML input types for different data formats.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Text" Type="text" Placeholder="Text input" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Email" Type="email" Placeholder="Email input" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Password" Type="password" Placeholder="Password" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Number" Type="number" Placeholder="Number input" Variant="InputVariant.Outlined" />
            </div>
            <CodeBlock Code="@TypesCode" Language="razor" />
        </div>

        <!-- Sizes -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Sizes</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Available in three sizes to fit different layouts and use cases.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Small" Size="ComponentSize.Small" Placeholder="Small input" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Medium" Size="ComponentSize.Medium" Placeholder="Medium input" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Large" Size="ComponentSize.Large" Placeholder="Large input" Variant="InputVariant.Outlined" />
            </div>
            <CodeBlock Code="@SizesCode" Language="razor" />
        </div>

        <!-- With Icons -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">With Icons</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Add leading or trailing icons to provide visual context for the input field.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Search" Placeholder="Search..." LeadingIcon="🔍" Variant="InputVariant.Outlined" />
                <Input TValue="string" Label="Password" Type="password" Placeholder="Password" LeadingIcon="🔒" Variant="InputVariant.Filled" />
                <Input TValue="string" Label="Email" Placeholder="you@example.com" TrailingIcon="✉️" Variant="InputVariant.Text" />
            </div>
            <CodeBlock Code="@IconsCode" Language="razor" />
        </div>

        <!-- Validation States -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Validation States</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Display helper text or error messages to guide user input.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Email" Type="email" Variant="InputVariant.Outlined" HelperText="Enter a valid email address" />
                <Input TValue="string" Label="Username" ErrorMessage="Username is required" Variant="InputVariant.Outlined" />
            </div>
            <CodeBlock Code="@ValidationCode" Language="razor" />
        </div>

        <!-- Disabled and ReadOnly -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Disabled and ReadOnly</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Prevent user interaction with disabled state or allow reading with readonly state.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input TValue="string" Label="Disabled" Placeholder="Disabled input" Disabled="true" Variant="InputVariant.Outlined" />
                <Input Label="Read-only" Value="@("Read-only value")" ReadOnly="true" Variant="InputVariant.Filled" />
            </div>
            <CodeBlock Code="@DisabledCode" Language="razor" />
        </div>

        <!-- Typed values -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-3">Typed values</h3>
            <p class="vibe-text-muted-foreground vibe-mb-4">
                Bind a number, a date or a time directly. The input type follows the bound type, and a
                nullable value goes back to null when the box is cleared. Text that is not a valid
                value stays in the box and marks the input invalid; the bound value keeps its last
                valid state.
            </p>
            <div class="vibe-space-y-3 vibe-p-6 vibe-bg-card vibe-rounded-lg vibe-border vibe-border-border vibe-mb-3">
                <Input Id="typed-quantity" Label="Quantity" @bind-Value="quantity" ParsingErrorMessage="Enter a whole number" />
                <Input Id="typed-price" Label="Price" @bind-Value="price" />
                <Input Id="typed-discount" Label="Discount (optional)" @bind-Value="discount" />
                <Input Id="typed-due" Label="Due" @bind-Value="due" />
                <Input Id="typed-starts" Label="Starts" @bind-Value="starts" />
                <Input Id="typed-shipped" Label="Shipped (optional)" @bind-Value="shipped" />
                <p id="typed-readout" class="vibe-text-sm vibe-text-muted-foreground">
                    quantity = @quantity · price = @price.ToString(System.Globalization.CultureInfo.InvariantCulture) ·
                    discount = @(discount?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "null") ·
                    due = @due.ToString("yyyy-MM-dd") · starts = @starts.ToString("HH:mm") ·
                    shipped = @(shipped?.ToString("yyyy-MM-dd") ?? "null")
                </p>
            </div>
            <CodeBlock Code="@TypedCode" Language="razor" />
        </div>
    </section>

    <!-- API Reference -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-6">API Reference</h2>

        <!-- Properties -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Properties</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Default</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Value</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="TValue" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">default</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">The input value. Strings, numbers, DateOnly, DateTime, TimeOnly, Guid and their nullable forms bind without a converter. A literal needs an expression: Value="@@("text")".</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">TValue</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="type" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">inferred</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">The value type. Inferred from Value or @@bind-Value. An input with neither needs TValue="string".</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Type</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">from TValue</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">HTML input type. Unset, it is number for numeric types, date for DateOnly, datetime-local for DateTime, time for TimeOnly, and text otherwise.</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ParsingErrorMessage</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">by type</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Message shown while the text does not convert to TValue and no ErrorMessage is set. Defaults to a short English sentence chosen by the value type; an empty string shows none.</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Placeholder</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Placeholder text</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Label</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Label text</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Variant</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="InputVariant" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Outlined</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Visual style variant</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Size</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="ComponentSize" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Medium</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Size of the input</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Disabled</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the input is disabled</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ReadOnly</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the input is read-only</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">Required</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="bool" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">false</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Whether the input is required</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ErrorMessage</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Error message to display</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">HelperText</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Helper text to guide the user</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">LeadingIcon</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Icon displayed at the start</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">TrailingIcon</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="string" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">null</td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Icon displayed at the end</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Events -->
        <div class="vibe-mb-8">
            <h3 class="vibe-text-lg vibe-font-medium vibe-text-foreground vibe-mb-4">Events</h3>
            <div class="vibe-overflow-x-auto" tabindex="0">
                <table class="vibe-w-full vibe-text-sm">
                    <thead>
                        <tr class="vibe-border-b vibe-border-border">
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Name</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Type</th>
                            <th class="vibe-text-left vibe-py-3 vibe-px-4 vibe-font-medium vibe-text-foreground">Description</th>
                        </tr>
                    </thead>
                    <tbody class="vibe-divide-y vibe-divide-border">
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">ValueChanged</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<TValue?>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Raised on every keystroke and on commit, with the converted value. Not raised while the text does not convert.</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnInput</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<ChangeEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Native input event callback</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnFocus</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<FocusEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Callback when input receives focus</td>
                        </tr>
                        <tr>
                            <td class="vibe-py-3 vibe-px-4 vibe-font-mono vibe-text-sm vibe-text-foreground">OnBlur</td>
                            <td class="vibe-py-3 vibe-px-4"><TypeBadge Type="EventCallback<FocusEventArgs>" /></td>
                            <td class="vibe-py-3 vibe-px-4 vibe-text-muted-foreground">Callback when input loses focus</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <!-- Installation -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Installation</h2>
        <p class="vibe-text-muted-foreground vibe-mb-4">
            Install the Input component using the Vibe.UI CLI:
        </p>
        <CodeBlock Code="vibe add input" Language="bash" />
    </section>

    <!-- Accessibility -->
    <section class="vibe-mb-12">
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Accessibility</h2>
        <ul class="vibe-space-y-2 vibe-text-muted-foreground">
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Uses semantic <code class="vibe-text-sm vibe-bg-secondary vibe-px-1 vibe-py-0.5 vibe-rounded">&lt;input&gt;</code> element
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Label properly associated with input for screen readers
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                ARIA attributes for error states and validation
            </li>
            <li class="vibe-flex vibe-items-start vibe-gap-2">
                <svg class="vibe-w-5 vibe-h-5 vibe-text-green-500 vibe-mt-0.5 vibe-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                Keyboard accessible with focus visible styles
            </li>
        </ul>
    </section>

    <!-- Related Components -->
    <section>
        <h2 class="vibe-text-xl vibe-font-semibold vibe-text-foreground vibe-mb-4">Related</h2>
        <div class="vibe-grid vibe-grid-cols-1 sm:vibe-grid-cols-3 vibe-gap-4">
            <a href="components/textarea" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Textarea</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Multi-line text input</p>
            </a>
            <a href="components/select" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Select</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Dropdown selection</p>
            </a>
            <a href="components/form" class="vibe-group vibe-p-4 vibe-rounded-lg vibe-border vibe-border-border hover:vibe-border-primary vibe-transition-colors">
                <h4 class="vibe-font-medium vibe-text-foreground group-hover:vibe-text-link">Form</h4>
                <p class="vibe-text-sm vibe-text-muted-foreground">Form validation and submission</p>
            </a>
        </div>
    </section>
</div>

@code {
