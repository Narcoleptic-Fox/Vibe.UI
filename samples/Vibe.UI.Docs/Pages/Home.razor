                        <span class="vibe-text-green-400">$</span>
                        <span class="vibe-text-muted-foreground">vibe init</span>
                    </div>
                    <div class="vibe-flex vibe-items-center vibe-gap-2 docs-terminal-line">
                        <span class="vibe-text-green-400">$</span>
                        <span class="vibe-text-muted-foreground">vibe add button card input dialog</span>
