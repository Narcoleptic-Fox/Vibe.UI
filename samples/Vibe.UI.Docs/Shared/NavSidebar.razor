@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@*
    NavSidebar - the documentation navigation: guides first, then every component page
    grouped by category. The lists come from DocsCatalog, the same source the component
    index uses, so the two cannot disagree about which pages exist.
*@

<nav class="docs-nav" aria-label="@Label" @ref="_nav">
    <div class="docs-nav-group">
        <p class="docs-nav-heading" id="@($"{_id}-guides")">Getting started</p>
        <ul aria-labelledby="@($"{_id}-guides")">
            @foreach (var guide in DocsCatalog.Guides)
            {
                <li>
                    <a class="docs-nav-link" href="@guide.Route" aria-current="@Current(guide.Route)">@guide.Title</a>
                </li>
            }
        </ul>
    </div>

    <div class="docs-nav-group">
        <p class="docs-nav-heading" id="@($"{_id}-components")">Components</p>
        <ul aria-labelledby="@($"{_id}-components")">
            <li>
                <a class="docs-nav-link" href="components" aria-current="@Current("components")">
                    All components
                    <span class="docs-nav-count">@DocsCatalog.Components.Count</span>
                </a>
            </li>
        </ul>
    </div>

    @foreach (var category in DocsCatalog.Categories)
    {
        var headingId = $"{_id}-{category.Name.Replace(' ', '-').ToLowerInvariant()}";

        <div class="docs-nav-group">
            <p class="docs-nav-heading" id="@headingId">@category.Name</p>
            <ul aria-labelledby="@headingId">
                @foreach (var component in category.Components)
                {
                    <li>
                        <a class="docs-nav-link" href="@component.RelativeRoute" aria-current="@Current(component)">
                            @component.Name
                            @if (component.IsNew)
                            {
                                <Badge Variant="default" class="vibe-text-xs">New</Badge>
                            }
                        </a>
                    </li>
                }
            </ul>
        </div>
    }
</nav>

@code {
    private readonly string _id = $"docs-nav-{Guid.NewGuid():N}";
    private ElementReference _nav;
    private string _currentPath = string.Empty;
    private bool _revealPending = true;

    /// <summary>
    /// Accessible name for the navigation landmark. The desktop rail and the phone drawer
    /// can both be in the page, so each needs its own.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "Documentation";

    protected override void OnInitialized()
    {
        _currentPath = GetCurrentPath();
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_revealPending)
        {
            return;
        }

        _revealPending = false;

        try
        {
            // The list is longer than the screen: keep the current page's link in view.
            await JS.InvokeVoidAsync("vibeDocs.revealCurrentNavLink", _nav);
        }
        catch (JSException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var path = GetCurrentPath();
        if (path == _currentPath)
        {
            return;
        }

        _currentPath = path;
        _revealPending = true;
        StateHasChanged();
    }

    private string GetCurrentPath() =>
        Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');

    private string? Current(string route) =>
        _currentPath.Equals(route, StringComparison.OrdinalIgnoreCase) ? "page" : null;

    // A component page can answer on more than one route (aliases), so match any of them.
    private string? Current(ComponentPage component) =>
        component.Routes.Any(route => _currentPath.Equals(route.Trim('/'), StringComparison.OrdinalIgnoreCase))
            ? "page"
            : null;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
