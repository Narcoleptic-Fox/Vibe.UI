<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Vibe.UI.FluentValidation</PackageId>
    <Version>1.0.0-beta</Version>
    <Title>Vibe.UI.FluentValidation - FluentValidation for Vibe.UI forms</Title>
    <Authors>Narcoleptic Fox</Authors>
    <Description>Lets Vibe.UI read labels, required and limits from FluentValidation validators, and
      writes their errors into a Blazor EditContext. Optional: reference it only if your models are
      validated with FluentValidation.</Description>
    <PackageTags>blazor;components;forms;validation;fluentvalidation</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</PackageProjectUrl>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <!-- 12.2.0 is the version the adapter is tested against. -->
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <ProjectReference Include="..\Vibe.UI\Vibe.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../icon.png" Pack="true" PackagePath="" Condition="Exists('../../icon.png')" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="" Condition="!Exists('../../icon.png') And Exists('../../assets/icon.png')" />
    <None Include="README.nuget.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
