@namespace Vibe.UI.Components
@using System.Runtime.CompilerServices
@using System.Text.Json
@using Microsoft.AspNetCore.Components.QuickGrid
@typeparam TGridItem
@* Named as QuickGrid names it, and cascaded, so that a PropertyColumn written inside
   works out its row type as it does inside a QuickGrid. *@
@attribute [CascadingTypeParameter(nameof(TGridItem))]
@inherits Base.VibeComponent
@implements IDisposable
@inject IServiceProvider Services

@* Microsoft's QuickGrid with the parts every page otherwise repeats: the pagination state, a
   paginator bound to it, the vibe theme, and one answer per question asked of the server. The
   columns are QuickGrid's own, written as its child content. *@
<div class="@CombinedClass" @attributes="AdditionalAttributes">
    <QuickGrid @ref="grid" TGridItem="TGridItem" ItemsProvider="provider" Pagination="pagination" Theme="vibe"
               ItemKey="@(ItemKey ?? DefaultItemKey)" RowClass="RowClass">
        @ChildContent
    </QuickGrid>

    @if (ShowPagination && PageCount > 1)
    {
        <div class="vibe-grid-pager">
            <Pagination CurrentPage="@(pagination.CurrentPageIndex + 1)" TotalPages="PageCount"
                        AriaLabel="@PaginationLabel"
                        PageChanged="@(page => pagination.SetCurrentPageIndexAsync(page - 1))" />
        </div>
    }
</div>

@code {
    private static readonly Func<TGridItem, object> DefaultItemKey = item => item!;

    private readonly PaginationState pagination = new();
    private readonly GridItemsProvider<TGridItem> provider;
    private QuickGrid<TGridItem>? grid;

    // The last page fetched and the question it answered. The same question asked again is
    // answered from here, because QuickGrid does ask again: it notes the state of its pagination
    // before the provider answers, that state includes the total, and it sets the total from the
    // answer. So after any answer that changes the total, its next render repeats the question.
    private (RequestKey Key, VibeGridPage<TGridItem> Page)? last;

    // Set by RefreshAsync: the next question goes to the provider whatever is remembered.
    private bool mustFetch;

    // The prerender handoff. A page is prerendered on the server and then rendered again,
    // interactively, by a new grid. The first keeps the page it fetched, as JSON, and the second
    // starts with it. The grid does the writing and reading itself, so that a row type JSON
    // cannot write or cannot rebuild costs one more request and not the page.
    private static readonly ConditionalWeakTable<PersistentComponentState, Dictionary<string, int>> NamesInUse = new();
    private PersistentComponentState? keptState;
    private PersistingComponentStateSubscription keeping;
    private string? keptJson;

    // The name this grid is counted under, from the moment it is counted. Not worked out
    // again later: a StateKey that changed would count it out of a name it was never in.
    private string? keptName;

    // Cancelled when the grid is disposed. QuickGrid cancels a question when it asks a newer
    // one, but not when it is taken off the page, so a question still out would run on.
    private readonly CancellationTokenSource disposal = new();

    public VibeGrid()
    {
        provider = ProvideAsync;
        pagination.TotalItemCountChanged += OnTotalItemCountChanged;
    }

    /// <summary>
    /// Fetches one page. Called once for each different question: on load, and on a change of
    /// page, page size or sort. The same question is not asked twice in a row unless
    /// <see cref="RefreshAsync"/> is called.
    /// </summary>
    [Parameter, EditorRequired]
    public Func<VibeGridRequest, ValueTask<VibeGridPage<TGridItem>>> ItemsProvider { get; set; } = default!;

    /// <summary>The columns: QuickGrid's <c>PropertyColumn</c> and <c>TemplateColumn</c>.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>How many rows a page holds.</summary>
    [Parameter]
    public int PageSize { get; set; } = 10;

    /// <summary>Whether the paginator is shown when there is more than one page.</summary>
    [Parameter]
    public bool ShowPagination { get; set; } = true;

    /// <summary>The accessible name of the paginator.</summary>
    [Parameter]
    public string PaginationLabel { get; set; } = "Pages";

    /// <summary>
    /// What identifies a row across renders, such as <c>item =&gt; item.Id</c>. Unset, the row
    /// itself is the key.
    /// </summary>
    [Parameter]
    public Func<TGridItem, object>? ItemKey { get; set; }

    /// <summary>A CSS class for a row, by its item.</summary>
    [Parameter]
    public Func<TGridItem, string?>? RowClass { get; set; }

    /// <summary>
    /// Tells this grid's prerendered page apart from another's. The page the server fetches
    /// while prerendering is kept for the interactive render under the row type and this key.
    /// Two grids of one row type on a page need different keys; left the same, neither page is
    /// kept and each grid fetches again.
    /// </summary>
    [Parameter]
    public string? StateKey { get; set; }

    /// <inheritdoc />
    protected override string ComponentClass => "vibe-grid";

    private int PageCount => (pagination.LastPageIndex ?? 0) + 1;

    // Under which name this grid's prerendered page is kept.
    private string KeptPageName => $"Vibe.UI.VibeGrid:{typeof(TGridItem).FullName}:{StateKey}";

    // Whether this render is a prerender that an interactive render will follow. A page with no
    // render mode is also not interactive, and nothing follows it. A grid there has nothing to
    // keep, and counted as a user of its name it would cost an interactive grid beside it,
    // under the same name, its page.
    private bool IsPrerenderingForAnInteractiveRender =>
        !RendererInfo.IsInteractive && AssignedRenderMode is not null;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        // Not injected: a host that has no such service still gets a grid, without the handoff.
        // That host is every component test that does not ask for one, and nothing past this
        // point is reached there: such a test need not say how it is being rendered.
        keptState = Services.GetService(typeof(PersistentComponentState)) as PersistentComponentState;
        if (keptState is null)
        {
            return;
        }

        if (RendererInfo.IsInteractive)
        {
            // What the prerender fetched becomes the first thing remembered, so QuickGrid's
            // first question here is answered without asking the provider.
            if (keptState.TryTakeFromJson(KeptPageName, out string? json)
                && json is not null
                && ReadKeptPage(json) is { } carried)
            {
                last = (new RequestKey(carried.StartIndex, carried.PageSize, carried.SortBy, carried.SortDescending), carried.Page);
            }
        }
        else if (IsPrerenderingForAnInteractiveRender)
        {
            keptName = KeptPageName;
            Dictionary<string, int> names = NamesInUse.GetOrCreateValue(keptState);
            names[keptName] = names.GetValueOrDefault(keptName) + 1;
            // The framework takes the render mode to keep the page for from this component.
            keeping = keptState.RegisterOnPersisting(KeepPageAsync);
        }
    }

    // Runs once the prerender is finished, when every grid on the page has been counted.
    private Task KeepPageAsync()
    {
        // The framework refuses a name that is already in use, and a refusal costs the page
        // everything kept on it: seen in a browser, where two grids under one name left a third,
        // under a name of its own, to fetch again. So a name used twice keeps nothing.
        if (keptJson is not null
            && keptName is not null
            && keptState is not null
            && NamesInUse.TryGetValue(keptState, out Dictionary<string, int>? names)
            && names.GetValueOrDefault(keptName) == 1)
        {
            keptState.PersistAsJson(keptName, keptJson);
        }

        return Task.CompletedTask;
    }

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (ItemsProvider is null)
        {
            throw new InvalidOperationException(
                $"{nameof(VibeGrid<TGridItem>)} needs an {nameof(ItemsProvider)}.");
        }

        pagination.ItemsPerPage = Math.Max(1, PageSize);
    }

    /// <summary>
    /// Asks the provider again. Call it when something outside the grid has changed what the
    /// provider would answer: a filter, or a row added or removed.
    /// </summary>
    /// <param name="toFirstPage">Go back to the first page, as a changed filter needs.</param>
    public async Task RefreshAsync(bool toFirstPage = false)
    {
        mustFetch = true;
        if (toFirstPage && pagination.CurrentPageIndex != 0)
        {
            // Changing the page makes QuickGrid ask by itself.
            await pagination.SetCurrentPageIndexAsync(0);
        }
        else if (grid is not null)
        {
            await grid.RefreshDataAsync();
        }
    }

    private async ValueTask<GridItemsProviderResult<TGridItem>> ProvideAsync(GridItemsProviderRequest<TGridItem> request)
    {
        int pageSize = request.Count ?? pagination.ItemsPerPage;
        SortedProperty sort = request.GetSortByProperties().FirstOrDefault();
        bool descending = sort.Direction == SortDirection.Descending;
        var key = new RequestKey(request.StartIndex, pageSize, sort.PropertyName, descending);

        VibeGridPage<TGridItem> page;
        if (!mustFetch && last is { } remembered && remembered.Key == key)
        {
            page = remembered.Page;
        }
        else
        {
            mustFetch = false;
            using var stopped = CancellationTokenSource.CreateLinkedTokenSource(
                request.CancellationToken, disposal.Token);

            // With a pagination state the start is always a whole number of pages.
            page = await ItemsProvider(new VibeGridRequest(
                request.StartIndex / pageSize, pageSize, sort.PropertyName, descending, stopped.Token));
            last = (key, page);

            if (keptName is not null)
            {
                keptJson = WriteKeptPage(new VibeGridSnapshot<TGridItem>(
                    key.StartIndex, key.PageSize, key.SortBy, key.SortDescending, page));
            }
        }

        return GridItemsProviderResult.From(
            page.Items as ICollection<TGridItem> ?? page.Items.ToList(), page.TotalCount);
    }

    // Null when the rows cannot be written: a row that refers back to itself, say. Then
    // nothing is kept and the interactive render fetches, as it did before there was a handoff.
    private static string? WriteKeptPage(VibeGridSnapshot<TGridItem> kept)
    {
        try
        {
            return JsonSerializer.Serialize(kept);
        }
        catch (Exception error) when (IsJsonFailure(error))
        {
            return null;
        }
    }

    // Null when what was kept cannot be turned back into the same rows: a row type with no
    // constructor JSON can use, text that is not a page at all, or rows that come back with
    // something missing.
    private static VibeGridSnapshot<TGridItem>? ReadKeptPage(string json)
    {
        try
        {
            VibeGridSnapshot<TGridItem>? kept = JsonSerializer.Deserialize<VibeGridSnapshot<TGridItem>>(json);
            if (kept?.Page?.Items is null)
            {
                return null;
            }

            // JSON rebuilds some types without complaint and without all their values: a
            // property with a private setter is written and then left empty. Written again, such
            // rows do not give the text they came from, and blank rows are worse than a request.
            return JsonSerializer.Serialize(kept) == json ? kept : null;
        }
        catch (Exception error) when (IsJsonFailure(error))
        {
            return null;
        }
    }

    // What System.Text.Json throws for a type it cannot handle. The third is the one it uses for
    // a constructor whose parameters do not match the type's properties.
    private static bool IsJsonFailure(Exception error) =>
        error is JsonException or NotSupportedException or InvalidOperationException;

    // The paginator is drawn by this component, so it has to render when the total arrives.
    private void OnTotalItemCountChanged(object? sender, int? total) => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc />
    public void Dispose()
    {
        pagination.TotalItemCountChanged -= OnTotalItemCountChanged;

        // A grid taken off the page while it is prerendered keeps nothing, and no longer stands
        // in the way of another under its name.
        keeping.Dispose();
        if (keptName is not null
            && keptState is not null
            && NamesInUse.TryGetValue(keptState, out Dictionary<string, int>? names))
        {
            names[keptName]--;
        }

        disposal.Cancel();
        disposal.Dispose();
    }

    private readonly record struct RequestKey(int StartIndex, int PageSize, string? SortBy, bool SortDescending);
}
