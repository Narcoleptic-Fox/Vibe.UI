@namespace Vibe.UI.Components
@using System.Globalization
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@typeparam TValue
@implements IDisposable
@inherits Vibe.UI.Base.VibeComponent

<div class="@CombinedClass">
    <div class="vibe-select-wrapper">
        <select id="@ElementId" class="vibe-select-input" value="@currentValue" disabled="@Disabled" @attributes="GetSelectAttributes()"
            @onchange="OnChangeHandler" @onfocus="OnFocus" @onblur="OnBlur" @onclick:stopPropagation>
            @if (IsClearable)
            {
                @* The empty option is how a nullable value returns to "nothing selected". *@
                <option value="" selected="@string.IsNullOrEmpty(currentValue)">@Placeholder</option>
            }
            else if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@string.IsNullOrEmpty(currentValue)">@Placeholder</option>
            }

            @if (ChildContent is not null)
            {
                @ChildContent
            }
            else if (EnumType is not null)
            {
                @foreach (var option in Enum.GetValues(EnumType))
                {
                    <option value="@option">@Vibe.UI.Metadata.ConventionMetadataProvider.ToLabel(option.ToString()!)</option>
                }
            }
        </select>

        @if (!string.IsNullOrEmpty(Label))
        {
            <label class="@GetLabelClass()" for="@ElementId">@Label</label>
        }

        <Icon Name="chevron-down" Size="16" CssClass="vibe-select-icon" />
    </div>

    @if (!string.IsNullOrEmpty(HelperText))
    {
        <div class="vibe-select-helper-text" id="@HelperId">@HelperText</div>
    }
</div>

@code {
    private readonly EditContextField formField = new();

    [CascadingParameter]
    private EditContext? EditContext { get; set; }

    // The one way a value leaves this component: the binding first, so the model holds the new
    // value by the time the form validates the field.
    private async Task ReportAsync(TValue? value)
    {
        await ValueChanged.InvokeAsync(value);
        formField.NotifyChanged();
    }

    public void Dispose() => formField.Dispose();

    private readonly string _id = Guid.NewGuid().ToString();
    private bool isFocused = false;
    private string currentValue = string.Empty;

    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// Gets or sets the select ID
    /// </summary>
    [Parameter]
    public string? Id { get; set; }

    /// <summary>
    /// Gets or sets the label text
    /// </summary>
    [Parameter]
    public string? Label { get; set; }

    /// <summary>
    /// Gets or sets the placeholder text
    /// </summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>
    /// Gets or sets the helper text
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Gets or sets whether the select is disabled
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Gets or sets the current selected value. Option values are converted to and from
    /// <typeparamref name="TValue"/> with the framework's binding converter, so strings, numbers,
    /// <see cref="Guid"/>, enums and their nullable forms bind without a converter.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the selected value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Names the bound property to the form. <c>@bind-Value</c> supplies it; it is what lets the
    /// component tell an <see cref="EditContext"/> which field changed.
    /// </summary>
    [Parameter]
    public Expression<Func<TValue>>? ValueExpression { get; set; }

    /// <summary>
    /// Gets or sets the select options. When omitted and <typeparamref name="TValue"/> is an enum,
    /// one option per enum value is rendered.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether an empty option is offered so the value can be set back to nothing.
    /// Defaults to true for a nullable value type such as <c>int?</c> or a nullable enum, and to
    /// false otherwise. The empty option shows the <see cref="Placeholder"/> text.
    /// </summary>
    [Parameter]
    public bool? Clearable { get; set; }

    /// <summary>
    /// Gets or sets the callback for when the value changes
    /// </summary>
    [Parameter]
    public EventCallback<ChangeEventArgs> OnChange { get; set; }

    /// <inheritdoc/>
    protected override string ComponentClass => GetContainerClass();

    /// <summary>
    /// Gets the ID of the select element
    /// </summary>
    private string ElementId => FieldContext?.ControlId
        ?? (string.IsNullOrWhiteSpace(Id) ? _id : Id);

    private string HelperId => $"{ElementId}-helper";

    private static readonly Type ValueType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private static readonly Type? EnumType = ValueType.IsEnum ? ValueType : null;

    private bool IsClearable => Clearable ?? Nullable.GetUnderlyingType(typeof(TValue)) is not null;

    protected override void OnParametersSet()
    {
        formField.Update(EditContext, ValueExpression);

        // The same converter InputSelect uses, in the invariant culture so "1.5" round-trips.
        currentValue = BindConverter.FormatValue(Value, CultureInfo.InvariantCulture)?.ToString() ?? string.Empty;

        if (Disabled)
        {
            isFocused = false;
        }
    }

    private string GetContainerClass()
        => new ClassBuilder()
            .Add("vibe-select")
            .AddIf("vibe-select-disabled", Disabled)
            .AddIf("vibe-select-error", FieldContext?.IsInvalid == true)
            .Build();

    private string GetLabelClass()
    {
        var classes = new List<string> { "vibe-select-label" };

        // Label should float when focused or when there's a selected value (not placeholder)
        if (isFocused)
            classes.Add("vibe-select-label-floating");

        return string.Join(" ", classes);
    }

    private void OnFocus(FocusEventArgs e)
    {
        if (!Disabled)
        {
            isFocused = true;
        }
    }

    private void OnBlur(FocusEventArgs e)
    {
        isFocused = false;
    }

    private async Task OnChangeHandler(ChangeEventArgs args)
    {
        if (Disabled)
        {
            return;
        }

        var selected = args.Value?.ToString() ?? string.Empty;

        // The converter also rejects a number that is not a defined enum value, such as "99".
        if (!BindConverter.TryConvertTo<TValue>(selected, CultureInfo.InvariantCulture, out var value))
        {
            // Dropping it would leave the control showing one thing and the model holding another.
            throw new InvalidOperationException(
                $"Select<{typeof(TValue).Name}> could not convert the option value '{selected}' to {typeof(TValue).Name}. "
                + "Check that every option's value is valid for the bound type.");
        }

        currentValue = selected;

        if (ValueChanged.HasDelegate)
        {
            await ReportAsync(value);
        }

        if (OnChange.HasDelegate)
        {
            await OnChange.InvokeAsync(args);
        }
    }

    private Dictionary<string, object>? GetSelectAttributes()
    {
        Dictionary<string, object>? attributes = null;

        if (AdditionalAttributes is { Count: > 0 })
        {
            attributes = new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);

            foreach (var attribute in AdditionalAttributes)
            {
                if (!IsReservedSelectAttribute(attribute.Key))
                {
                    attributes[attribute.Key] = attribute.Value;
                }
            }
        }

        if (!string.IsNullOrEmpty(HelperText))
        {
            attributes ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            MergeSpaceSeparatedAttribute(attributes, "aria-describedby", HelperId);
        }

        if (!string.IsNullOrWhiteSpace(FieldContext?.DescribedBy))
        {
            attributes ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            MergeSpaceSeparatedAttribute(attributes, "aria-describedby", FieldContext.DescribedBy);
        }

        if (FieldContext?.IsInvalid == true)
        {
            attributes ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            attributes["aria-invalid"] = "true";
            if (!string.IsNullOrWhiteSpace(FieldContext.ErrorId))
            {
                attributes["aria-errormessage"] = FieldContext.ErrorId;
            }
        }

        if (FieldContext?.IsRequired == true)
        {
            attributes ??= new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase);
            attributes["required"] = "required";
            attributes["aria-required"] = "true";
        }

        return attributes is { Count: > 0 } ? attributes : null;
    }

    private static bool IsReservedSelectAttribute(string attributeName)
        => attributeName.Equals("class", StringComparison.OrdinalIgnoreCase)
            || attributeName.Equals("id", StringComparison.OrdinalIgnoreCase)
            || attributeName.Equals("value", StringComparison.OrdinalIgnoreCase)
            || attributeName.Equals("disabled", StringComparison.OrdinalIgnoreCase);

    private static void MergeSpaceSeparatedAttribute(Dictionary<string, object> target, string key, string value)
    {
        if (!target.TryGetValue(key, out var existingValue) || existingValue is null)
        {
            target[key] = value;
            return;
        }

        var tokens = existingValue.ToString()!
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries))
            .Distinct(StringComparer.Ordinal);

        target[key] = string.Join(" ", tokens);
    }
}
