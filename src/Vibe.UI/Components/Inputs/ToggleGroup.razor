@namespace Vibe.UI.Components
@typeparam TValue
@attribute [CascadingTypeParameter(nameof(TValue))]
@inherits VibeComponent
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable
@implements IToggleGroupContext

<div id="@EffectiveId" @attributes="AdditionalAttributes" class="@CombinedCssClass" role="group" aria-label="@AriaLabel"
    aria-orientation="@EffectiveOrientation.ToString().ToLowerInvariant()" aria-disabled="@AriaBool(Disabled)"
    aria-describedby="@EffectiveDescribedBy" aria-invalid="@AriaInvalidValue" aria-errormessage="@EffectiveErrorMessageId">
    <CascadingValue TValue="IToggleGroupContext" Value="this" IsFixed="true">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else if (EnumValues is not null)
        {
            @foreach (var value in EnumValues)
            {
                <ToggleGroupItem TValue="TValue" Value="value">@Vibe.UI.Metadata.ConventionMetadataProvider.ToLabel(value!.ToString()!)</ToggleGroupItem>
            }
        }
    </CascadingValue>
</div>

@code {
    private TValue? _value;
    private List<TValue> _values = new();
    private readonly List<IToggleGroupItem> _items = new();

    private static readonly System.Type ValueType = Nullable.GetUnderlyingType(typeof(TValue)) ?? typeof(TValue);

    private static readonly TValue[]? EnumValues = ValueType.IsEnum
        ? Enum.GetValues(ValueType).Cast<object>().Select(value => (TValue)value).ToArray()
        : null;

    // Releasing the pressed item of a single group means "no value", which only a type that
    // can be null is able to say. An int group keeps its value instead.
    private static readonly bool CanBeEmpty = default(TValue) is null;
    private IJSObjectReference? _domModule;
    private string? _rovingItemId;
    private string? _pendingFocusId;

    /// <summary>
    /// Gets the relationships cascaded by an ancestor <see cref="FormField{TValue}"/>, if any.
    /// </summary>
    [CascadingParameter]
    private FormFieldContext? FieldContext { get; set; }

    /// <summary>
    /// The content of the toggle group (ToggleGroupItem components). When omitted and
    /// <typeparamref name="TValue"/> is an enum, one item per enum value is rendered.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// The type of toggle group (single or multiple selection).
    /// </summary>
    [Parameter]
    public ToggleGroupType Type { get; set; } = ToggleGroupType.Single;

    /// <summary>
    /// The currently selected value (for single selection). Pressing the selected item again
    /// clears it when <typeparamref name="TValue"/> can be null, and does nothing otherwise.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// The currently selected values (for multiple selection).
    /// </summary>
    [Parameter]
    public List<TValue> Values { get; set; } = new();

    /// <summary>
    /// Event callback when the value changes.
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Event callback when the values change (for multiple selection).
    /// </summary>
    [Parameter]
    public EventCallback<List<TValue>> ValuesChanged { get; set; }

    /// <summary>
    /// Whether the toggle group is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// The orientation of the toggle group.
    /// </summary>
    [Parameter]
    public ToggleGroupOrientation Orientation { get; set; } = ToggleGroupOrientation.Horizontal;

    /// <summary>
    /// The size variant of the toggle group.
    /// </summary>
    [Parameter]
    public ToggleGroupSize Size { get; set; } = ToggleGroupSize.Default;

    /// <summary>
    /// Accessible label for the toggle group.
    /// </summary>
    [Parameter]
    public string? AriaLabel { get; set; }

    /// <summary>
    /// Additional CSS classes to apply.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    private string CombinedCssClass => CombineClasses(
    "vibe-toggle-group",
    $"vibe-toggle-group-{EffectiveOrientation.ToString().ToLowerInvariant()}",
    $"vibe-toggle-group-{EffectiveSize.ToString().ToLowerInvariant()}",
    Disabled ? "vibe-toggle-group-disabled" : null,
    Class,
    CssClass
    );

    protected override string ComponentClass => CombinedCssClass;

    private ToggleGroupType EffectiveType => Enum.IsDefined(typeof(ToggleGroupType), Type) ? Type : ToggleGroupType.Single;

    private ToggleGroupOrientation EffectiveOrientation
        => Enum.IsDefined(typeof(ToggleGroupOrientation), Orientation) ? Orientation : ToggleGroupOrientation.Horizontal;

    private ToggleGroupSize EffectiveSize => Enum.IsDefined(typeof(ToggleGroupSize), Size) ? Size : ToggleGroupSize.Default;

    private string? EffectiveId => FieldContext?.ControlId;

    private string? EffectiveDescribedBy => FieldContext?.DescribedBy;

    private string? AriaInvalidValue => FieldContext?.IsInvalid == true ? "true" : null;

    private string? EffectiveErrorMessageId => FieldContext?.IsInvalid == true && !string.IsNullOrWhiteSpace(FieldContext.ErrorId)
        ? FieldContext.ErrorId
        : null;

    protected override void OnParametersSet()
    {
        _value = Value;
        _values = Values?.Where(value => value is not null).ToList() ?? new List<TValue>();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingFocusId is not string focusId)
        {
            return;
        }

        _pendingFocusId = null;

        try
        {
            _domModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/Vibe.UI/js/vibe-dom.js");
            await _domModule.InvokeVoidAsync("focusElement", focusId);
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static string AriaBool(bool value) => value ? "true" : "false";

    private static bool SameValue(TValue? left, TValue? right) => EqualityComparer<TValue?>.Default.Equals(left, right);

    // The item's own type is not always the group's; see ItemValue.
    private static TValue? Coerce(object? itemValue) => Vibe.UI.Base.ItemValue.Coerce<TValue>(itemValue, "ToggleGroup");

    bool IToggleGroupContext.IsSelected(object? itemValue) => IsSelected(Coerce(itemValue));

    Task IToggleGroupContext.ToggleAsync(object? itemValue) => HandleItemToggle(Coerce(itemValue));

    // A disabled group needs no check here: its items are disabled and never call this.
    private async Task HandleItemToggle(TValue? itemValue)
    {
        if (EffectiveType == ToggleGroupType.Single)
        {
            if (!SameValue(_value, itemValue))
            {
                _value = itemValue;
                await ValueChanged.InvokeAsync(itemValue);
            }
            else if (CanBeEmpty && _value is not null)
            {
                _value = default;
                await ValueChanged.InvokeAsync(default);
            }
            else
            {
                return;
            }
        }
        else
        {
            if (itemValue is null)
            {
                return;
            }

            var updatedValues = _values.ToList();
            var index = updatedValues.FindIndex(value => SameValue(value, itemValue));
            if (index >= 0)
            {
                updatedValues.RemoveAt(index);
            }
            else
            {
                updatedValues.Add(itemValue);
            }

            _values = updatedValues;
            await ValuesChanged.InvokeAsync(updatedValues);
        }

        await InvokeAsync(StateHasChanged);
    }

    void IToggleGroupContext.RegisterItem(IToggleGroupItem item) => RegisterItem(item);

    private void RegisterItem(IToggleGroupItem item)
    {
        if (_items.Contains(item))
        {
            return;
        }

        _items.Add(item);
        StateHasChanged();
    }

    void IToggleGroupContext.RemoveItem(IToggleGroupItem item)
    {
        if (!_items.Remove(item))
        {
            return;
        }

        if (_rovingItemId == item.ElementId)
        {
            _rovingItemId = null;
        }
    }

    void IToggleGroupContext.NotifyItemChanged(IToggleGroupItem item)
    {
        if (!_items.Contains(item))
        {
            RegisterItem(item);
            return;
        }

        if (_rovingItemId == item.ElementId && item.IsEffectivelyDisabled)
        {
            _rovingItemId = null;
        }

        StateHasChanged();
    }

    int IToggleGroupContext.GetItemTabIndex(IToggleGroupItem item)
    {
        if (Disabled || item.IsEffectivelyDisabled)
        {
            return -1;
        }

        var tabStop = GetTabStopItem();
        return ReferenceEquals(tabStop, item) ? 0 : -1;
    }

    void IToggleGroupContext.HandleItemFocus(IToggleGroupItem item)
    {
        if (!Disabled && !item.IsEffectivelyDisabled && _rovingItemId != item.ElementId)
        {
            _rovingItemId = item.ElementId;
            StateHasChanged();
        }
    }

    Task IToggleGroupContext.HandleItemKeyDown(IToggleGroupItem item, KeyboardEventArgs args)
    {
        if (Disabled || item.IsEffectivelyDisabled)
        {
            return Task.CompletedTask;
        }

        var enabledItems = _items.Where(candidate => !candidate.IsEffectivelyDisabled).ToList();
        var currentIndex = enabledItems.IndexOf(item);
        if (currentIndex < 0 || enabledItems.Count == 0)
        {
            return Task.CompletedTask;
        }

        IToggleGroupItem? target = args.Key switch
        {
            "Home" => enabledItems[0],
            "End" => enabledItems[^1],
            "ArrowRight" when EffectiveOrientation == ToggleGroupOrientation.Horizontal
                => enabledItems[(currentIndex + 1) % enabledItems.Count],
            "ArrowLeft" when EffectiveOrientation == ToggleGroupOrientation.Horizontal
                => enabledItems[(currentIndex - 1 + enabledItems.Count) % enabledItems.Count],
            "ArrowDown" when EffectiveOrientation == ToggleGroupOrientation.Vertical
                => enabledItems[(currentIndex + 1) % enabledItems.Count],
            "ArrowUp" when EffectiveOrientation == ToggleGroupOrientation.Vertical
                => enabledItems[(currentIndex - 1 + enabledItems.Count) % enabledItems.Count],
            _ => null
        };

        if (target is null)
        {
            return Task.CompletedTask;
        }

        _rovingItemId = target.ElementId;
        _pendingFocusId = target.ElementId;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private IToggleGroupItem? GetTabStopItem()
    {
        var enabledItems = _items.Where(item => !item.IsEffectivelyDisabled).ToList();

        var rovingItem = enabledItems.FirstOrDefault(item => item.ElementId == _rovingItemId);
        if (rovingItem is not null)
        {
            return rovingItem;
        }

        return enabledItems.FirstOrDefault(item => IsSelected(Coerce(item.ItemValue)))
            ?? enabledItems.FirstOrDefault();
    }

    // Plain equality. A zero is a value like any other; in a single group a null value presses
    // only an item written with a null value.
    private bool IsSelected(TValue? itemValue)
    {
        return EffectiveType == ToggleGroupType.Single
        ? SameValue(_value, itemValue)
        : itemValue is not null && _values.Exists(value => SameValue(value, itemValue));
    }

    public async ValueTask DisposeAsync()
    {
        if (_domModule is null)
        {
            return;
        }

        try
        {
            await _domModule.DisposeAsync();
        }
        catch (Exception exception) when (IsRecoverableJsInteropException(exception))
        {
        }
    }

    private static bool IsRecoverableJsInteropException(Exception exception) =>
        exception is JSException or JSDisconnectedException or InvalidOperationException or TaskCanceledException;
}
