<Project Sdk="Microsoft.NET.Sdk">

      <PropertyGroup>
            <OutputType>Exe</OutputType>
            <TargetFramework>net10.0</TargetFramework>
            <ImplicitUsings>enable</ImplicitUsings>
            <Nullable>enable</Nullable>
            <PackAsTool>true</PackAsTool>
            <ToolCommandName>vibe</ToolCommandName>
            <PackageId>Vibe.UI.CLI</PackageId>
            <Version>1.0.0-beta</Version>
            <Authors>Narcoleptic Fox</Authors>
            <Description>CLI tool for adding Vibe.UI components to Blazor projects. Copies component
                  source code into your project (shadcn/ui style) - no package dependencies
                  required.</Description>
            <PackageTags>blazor;ui;components;cli;dotnet-tool;shadcn;vibe</PackageTags>
            <PackageLicenseExpression>MIT</PackageLicenseExpression>
            <PackageIcon>icon.png</PackageIcon>
            <RepositoryUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</RepositoryUrl>
            <RepositoryType>git</RepositoryType>
            <PackageProjectUrl>https://github.com/Narcoleptic-Fox/Vibe.UI</PackageProjectUrl>
            <PackageReadmeFile>README.cli.md</PackageReadmeFile>
      </PropertyGroup>

	      <ItemGroup>
            <PackageReference Include="Spectre.Console" Version="0.57.2" />
            <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
      </ItemGroup>

      <ItemGroup>
            <ProjectReference Include="..\Vibe.UI.CSS\Vibe.UI.CSS.csproj" />
      </ItemGroup>

      <ItemGroup>
            <!-- The built-in palettes, generated from themes/*.json. Compiled into the CLI from
                 the library's copy so `vibe init` writes the same colors the theme service does. -->
            <Compile Include="..\Vibe.UI\Services\Theme\ThemePaletteData.g.cs"
                     Link="Generated\ThemePaletteData.g.cs" />
      </ItemGroup>

      <ItemGroup>
            <!-- Components from Vibe.UI (packed into Templates/Components/) -->
            <None Include="../Vibe.UI/Components/Inputs/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Inputs/" />
            <None Include="../Vibe.UI/Components/Inputs/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Inputs/" />
            <None Include="../Vibe.UI/Components/Form/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Form/" />
            <None Include="../Vibe.UI/Components/Form/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Form/" />
            <None Include="../Vibe.UI/Components/DataDisplay/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/DataDisplay/" />
            <None Include="../Vibe.UI/Components/DataDisplay/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/DataDisplay/" />
            <None Include="../Vibe.UI/Components/Layout/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Layout/" />
            <None Include="../Vibe.UI/Components/Layout/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Layout/" />
            <None Include="../Vibe.UI/Components/Navigation/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Navigation/" />
            <None Include="../Vibe.UI/Components/Navigation/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Navigation/" />
            <None Include="../Vibe.UI/Components/Overlay/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Overlay/" />
            <None Include="../Vibe.UI/Components/Overlay/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Overlay/" />
            <None Include="../Vibe.UI/Components/Feedback/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Feedback/" />
            <None Include="../Vibe.UI/Components/Feedback/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Feedback/" />
            <None Include="../Vibe.UI/Components/Advanced/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Advanced/" />
            <None Include="../Vibe.UI/Components/Advanced/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Advanced/" />
            <None Include="../Vibe.UI/Components/Disclosure/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Disclosure/" />
            <None Include="../Vibe.UI/Components/Disclosure/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Disclosure/" />
            <None Include="../Vibe.UI/Components/DateTime/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/DateTime/" />
            <None Include="../Vibe.UI/Components/DateTime/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/DateTime/" />
            <None Include="../Vibe.UI/Components/Theme/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Theme/" />
            <None Include="../Vibe.UI/Components/Theme/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Theme/" />
            <None Include="../Vibe.UI/Components/Utility/*.razor"
                  Pack="true"
                  PackagePath="Templates/Components/Utility/" />
            <None Include="../Vibe.UI/Components/Utility/*.razor.css"
                  Pack="true"
                  PackagePath="Templates/Components/Utility/" />

	            <!-- Infrastructure files (packed into Templates/Infrastructure/) -->
	            <None Include="../Vibe.UI/Base/**/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/Base/%(RecursiveDir)" />
	            <!-- Types that components share but that are not components themselves
	                 (FormFieldContext, DialogContext). vibe init always copies them.
	                 Pack appends the recursive directory itself, so it is not repeated here. -->
	            <None Include="../Vibe.UI/Components/**/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/Components/" />
	            <None Include="../Vibe.UI/Configuration/**/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/Configuration/%(RecursiveDir)" />
	            <None Include="../Vibe.UI/Metadata/**/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/Metadata/%(RecursiveDir)" />
	            <!-- The FluentValidation adapter. Copied only when vibe init is asked for it.
	                 Not recursive: the folder also holds bin/ and obj/. -->
	            <None Include="../Vibe.UI.FluentValidation/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/FluentValidation/" />
	            <None Include="../Vibe.UI/Services/**/*.cs"
	                  Pack="true"
	                  PackagePath="Templates/Infrastructure/Services/%(RecursiveDir)" />
	            <None Include="../Vibe.UI/Enums/*.cs"
	                  Pack="true"
                  PackagePath="Templates/Infrastructure/Enums/" />
            <None Include="../Vibe.UI/ServiceCollectionExtensions.cs"
                  Pack="true"
                  PackagePath="Templates/Infrastructure/" />
            <None Include="../Vibe.UI/_Imports.razor"
                  Pack="true"
                  PackagePath="Templates/Infrastructure/" />

            <!-- JavaScript files -->
            <None Include="../Vibe.UI/wwwroot/js/*.js"
                  Pack="true"
                  PackagePath="Templates/wwwroot/js/" />

            <!-- CSS foundation files -->
            <None Include="../Vibe.UI/wwwroot/css/vibe-base.css"
                  Pack="true"
                  PackagePath="Templates/wwwroot/css/" />
            <None Include="../Vibe.UI/wwwroot/css/vibe-preflight.css"
                  Pack="true"
                  PackagePath="Templates/wwwroot/css/" />
            <None Include="../Vibe.UI/wwwroot/css/vibe-utilities.css"
                  Pack="true"
                  PackagePath="Templates/wwwroot/css/" />

            <!-- Package assets -->
            <None Include="../../icon.png" Pack="true" PackagePath=""
                  Condition="Exists('../../icon.png')" />
            <None Include="../../assets/icon.png" Pack="true" PackagePath=""
                  Condition="!Exists('../../icon.png') And Exists('../../assets/icon.png')" />
            <None Include="README.cli.md" Pack="true" PackagePath="" />
      </ItemGroup>

      <!-- The FluentValidation version the adapter is built and tested with, read from the
           adapter's own project so the version `vibe init` writes cannot drift from it. -->
      <!-- The version of each package a copied component needs, read from the library's own
           project so the version `vibe add` writes cannot drift from the one it is built with. -->
      <Target Name="RecordComponentPackageVersions" BeforeTargets="GetAssemblyAttributes">
            <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../Vibe.UI/Vibe.UI.csproj"
                     Query="/Project/ItemGroup/PackageReference[@Include='Microsoft.AspNetCore.Components.QuickGrid']/@Version">
                  <Output TaskParameter="Result" PropertyName="LibraryQuickGridVersion" />
            </XmlPeek>
            <Error Condition="'$(LibraryQuickGridVersion)' == ''"
                   Text="Could not read the QuickGrid version from Vibe.UI.csproj." />
            <ItemGroup>
                  <AssemblyMetadata Include="ComponentPackageVersion:Microsoft.AspNetCore.Components.QuickGrid" Value="$(LibraryQuickGridVersion)" />
            </ItemGroup>
      </Target>

      <Target Name="RecordAdapterFluentValidationVersion" BeforeTargets="GetAssemblyAttributes">
            <XmlPeek XmlInputPath="$(MSBuildThisFileDirectory)../Vibe.UI.FluentValidation/Vibe.UI.FluentValidation.csproj"
                     Query="/Project/ItemGroup/PackageReference[@Include='FluentValidation']/@Version">
                  <Output TaskParameter="Result" PropertyName="AdapterFluentValidationVersion" />
            </XmlPeek>
            <Error Condition="'$(AdapterFluentValidationVersion)' == ''"
                   Text="Could not read the FluentValidation version from Vibe.UI.FluentValidation.csproj." />
            <ItemGroup>
                  <AssemblyMetadata Include="FluentValidationVersion" Value="$(AdapterFluentValidationVersion)" />
            </ItemGroup>
      </Target>

</Project>

