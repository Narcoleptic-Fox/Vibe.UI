@* Outside any form, bound to a static member: nothing here names a field of a model, and it
   has to keep working. *@
<Input Id="shared" @bind-Value="Shared" />
<Checkbox Id="shared-checkbox" @bind-Checked="SharedFlag" />
<Switch Id="shared-switch" @bind-Checked="SharedFlag" />
<DatePicker @bind-Date="SharedDate" />
<TextArea Id="shared-notes" @bind-Value="Shared" />

@code {
    public static string? Shared { get; set; }

    public static bool SharedFlag { get; set; }

    public static DateTime? SharedDate { get; set; }
}
